    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Radzen.Blazor" Version="10.2.3" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LineControlCenter.Application\LineControlCenter.Application.csproj" />
    <ProjectReference Include="..\LineControlCenter.Domain\LineControlCenter.Domain.csproj" />
    <ProjectReference Include="..\LineControlCenter.Infrastructure\LineControlCenter.Infrastructure.csproj" />
  </ItemGroup>

</Project>

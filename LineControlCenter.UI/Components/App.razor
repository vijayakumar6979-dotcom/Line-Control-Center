@using System.Security.Principal
@using System.Runtime.Versioning
@using LineControlCenter.UI.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject UserSessionService UserSession

@inject IConfiguration Configuration
@{
    var useWindowsAuth = bool.Parse(Configuration["Feedback:UseWindowsAuth"] ?? "false");

    string? ntLogin = null;
    if (useWindowsAuth)
    {
        // Try 1: HttpContext (works when Windows Auth is negotiated by IIS)
        ntLogin = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

        // Try 2: WindowsIdentity of the server process (Kestrel dev fallback)
        if (string.IsNullOrWhiteSpace(ntLogin) && OperatingSystem.IsWindows())
            ntLogin = GetCurrentWindowsUser();
    }

    UserSession.SetNtLogin(ntLogin);
}

@code {
    [SupportedOSPlatform("windows")]
    private static string? GetCurrentWindowsUser()
    {
        try { return WindowsIdentity.GetCurrent().Name; }
        catch { return null; }
    }
}


@using MudBlazor
@inject LineControlCenter.UI.Services.RefreshStateService RefreshState
@implements IDisposable

<div style="background:#0a1628; border:1px solid #1a3a5c;
            border-radius:16px; overflow:hidden;
            box-shadow:0 4px 30px #00000060;
            margin-top:20px; margin-bottom:16px;">
    <div style="height:3px; background:linear-gradient(90deg,#00d4ff,#00d4ff88,transparent);"></div>
    <div style="display:flex; align-items:center; gap:12px; padding:14px 20px 12px;">
        <div style="width:34px; height:34px; border-radius:10px;
                    background:linear-gradient(135deg,#00d4ff18,#00d4ff08);
                    border:1px solid #00d4ff30;
                    display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <MudIcon Icon="@Icons.Material.Filled.Videocam" Style="color:#00d4ff; font-size:17px;" />
        </div>
        <div>
            <div style="color:#e8f4f8; font-family:'Orbitron',sans-serif;
                        font-size:11px; font-weight:700; letter-spacing:3px;">BACKEND — SOMS</div>
            <div style="color:#7ab3cc; font-size:8px; letter-spacing:1px; margin-top:2px;">
                BAY 16B &nbsp;·&nbsp; REAL-TIME MONITOR
            </div>
        </div>
        <div style="margin-left:auto; display:flex; align-items:center; gap:5px;
                    background:#00d4ff12; border:1px solid #00d4ff28;
                    border-radius:20px; padding:3px 10px;">
            <div style="width:5px; height:5px; border-radius:50%; background:#00d4ff;
                        box-shadow:0 0 6px #00d4ff; animation:lcc-bay-pulse 1.8s ease-in-out infinite;"></div>
            <span style="color:#00d4ff; font-size:8px; font-weight:700; letter-spacing:1px;">LIVE</span>
        </div>
    </div>
    <div style="padding:0 16px 16px;">
        <div style="border-radius:10px; overflow:hidden;
                    border:1px solid #1a3a5c;
                    background:#060d1f;
                    position:relative;
                    width:100%;
                    aspect-ratio:750 / 98;">
            <iframe src="http://awase1pgaict01:7777/watch/bayview?bay=LVL2%20P2%20Bay%2016B"
                    class="bay-iframe"
                    scrolling="no"
                    style="position:absolute; top:0; left:0;
                           width:100%; height:100%;
                           border:none; scrollbar-width:none;
                           pointer-events:none;
                           zoom:@RefreshState.SomsZoom.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);"
                    title="Bay B2M Top Live View">
            </iframe>
            @* Overlay: blocks iframe interaction but opens the REAL upstream SOMS feed directly in a new tab on click. *@
            <a href="http://awase1pgaict01:7777/watch/bayview?bay=LVL2%20P2%20Bay%2016B"
               target="_blank"
               rel="noopener noreferrer"
               style="position:absolute; inset:0; z-index:10; cursor:pointer;
                      display:block; text-decoration:none;"
               title="Open live feed in new tab"></a>
        </div>
    </div>
</div>

<style>
    .bay-iframe::-webkit-scrollbar { display: none; }
    .bay-iframe { scrollbar-width: none; -ms-overflow-style: none; }
</style>

@code {
    protected override void OnInitialized()
    {
        RefreshState.OnChange += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RefreshState.OnChange -= OnStateChanged;
    }
}

@implements IAsyncDisposable
@inject IJSRuntime JS

<div style="width:100%; height:100%; display:flex;
            align-items:center; justify-content:center;
            background:#060d1f; overflow:hidden; position:relative;">

    @if (_error != null)
    {
        <div style="color:#ff4444; font-size:12px; text-align:center; padding:16px;">
            Failed to load PDF page.<br />
            <span style="font-size:10px; color:#7ab3cc;">@_error</span>
        </div>
    }
    else if (_loading)
    {
        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">
            <div style="width:32px; height:32px; border-radius:50%;
                        border:2px solid #1a3a5c; border-top-color:#00b4d8;
                        animation:pdfCanvasSpin 0.9s linear infinite;"></div>
            <span style="color:#3d6b8a; font-size:10px; letter-spacing:1px;">LOADING…</span>
        </div>
        <style>
            @@keyframes pdfCanvasSpin { to { transform: rotate(360deg); } }
        </style>
    }

    <canvas id="@_canvasId"
            style="display:block; max-width:100%; max-height:100%;
                   object-fit:contain;
                   opacity:@(_loading ? "0" : "1");
                   transition:opacity 0.25s ease;"></canvas>
</div>

@code {
    [Parameter, EditorRequired] public string Url      { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int    Page     { get; set; } = 1;
    [Parameter]                 public int    Rotation { get; set; } = 0;

    private readonly string _canvasId = $"pdf-canvas-{Guid.NewGuid():N}";

    private IJSObjectReference? _module;
    private bool    _loading      = true;
    private string? _error        = null;
    private bool    _dirty        = true;
    private string  _lastUrl      = string.Empty;
    private int     _lastPage     = 0;
    private int     _lastRotation = int.MinValue;

    protected override void OnParametersSet()
    {
        if (Url != _lastUrl || Page != _lastPage || Rotation != _lastRotation)
            _dirty = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dirty && !firstRender) return;
        _dirty = false;
        await RenderAsync();
    }

    private async Task RenderAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        try
        {
            // Load the ES module once per component instance.
            // Because it is imported by URL (not a <script> tag), the browser
            // always fetches the current file — no caching from previous sessions.
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/pdfViewer.js");

            await _module.InvokeVoidAsync("renderPage", _canvasId, Url, Page, Rotation);

            _lastUrl      = Url;
            _lastPage     = Page;
            _lastRotation = Rotation;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null && !string.IsNullOrEmpty(_lastUrl))
        {
            try { await _module.InvokeVoidAsync("destroyDoc", _lastUrl); } catch { /* noop */ }
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { /* noop */ }
        }
    }
}

    // ── Briefing helpers ────────────────────────────────────────────────────

    /// Returns a key like "2025-06-14-AM" or "2025-06-14-PM" for the current shift window.
    private static string GetShiftKey()
    {
        var now   = DateTime.Now;
        var shift = now.Hour >= 7 && now.Hour < 19 ? "AM" : "PM";
        // Night shift that started previous day uses that day's date
        var date  = (now.Hour < 7) ? now.AddDays(-1).ToString("yyyy-MM-dd") : now.ToString("yyyy-MM-dd");
        return $"{date}-{shift}";
    }

    private async Task LoadBriefingStateAsync()
    {
        try
        {
            _lastShiftKey = GetShiftKey();
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", $"briefing_{_lastShiftKey}");
            _briefingViewed = stored == "1";
        }
        catch { _briefingViewed = false; }
    }

    private async Task OpenBriefing()
    {
        var options = new MudDialogOptions
        {
            MaxWidth      = MaxWidth.False,
            FullWidth     = true,
            FullScreen    = true,
            NoHeader      = true,
            CloseButton   = false,
            BackdropClick = false
        };
        await DialogService.ShowAsync<LineControlCenter.UI.Components.Dialogs.BriefingDialog>(
            null, options);

        // Mark as viewed after dialog closes
        _briefingViewed = true;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"briefing_{_lastShiftKey}", "1");
        }
        catch { /* ignore */ }
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        StopClock();
        RefreshState.OnDpmTargetChanged      -= HandleDpmTargetChanged;
        RefreshState.OnReconfigure           -= HandleReconfigure;
        RefreshState.OnRefreshRequested      -= HandleRefreshRequested;
        RefreshState.SetDashboardActive(false);
        return ValueTask.CompletedTask;
    }

    public class GroupItem
    {
        public string? Customer { get; set; }
        public string? Division { get; set; }
        public string? Family   { get; set; }
    }

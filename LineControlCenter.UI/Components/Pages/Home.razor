@code {
    private DashboardFilter        _filter        = new();
    private bool                   _initialized   = false;
    private bool                   _loading       = false;
    private DateTime               _currentTime   = DateTime.Now;
    private DateTime               _lastUpdated   = DateTime.Now;
    private DateTime?              _selectedDate  = DateTime.Today;
    private Timer?                 _clockTimer;
    private int                    _secondsUntilRefresh = 120;
    private double                 _refreshProgress     = 100;
    private const int              RefreshIntervalSeconds = 600;
    private bool                   _isRefreshing = false;

    // Briefing state
    private bool   _briefingViewed  = false;
    private string _lastShiftKey    = string.Empty;

    // Configure screen state
    private List<GroupItem>  _groups        = new();
    private GroupItem?       _selectedGroup = null;
    private bool             _groupsLoading = false;
    private string           _groupSearch   = "";
    private string?          _groupLoadError = null;
    private string?          _dataLoadError  = null;

    // Dashboard state — one CardModel per shift
    private CardModel _morningCard = new() { Shift = "Morning" };
    private CardModel _nightCard   = new() { Shift = "Night"   };

    // FNI yield state (WTD)
    private FniYieldSummaryDto _fniYield          = new(0, 0, 0, 0, []);
    private string?            _fniLoadError      = null;

    // FNI DPM state (Today)
    private FniYieldSummaryDto _fniDpmToday       = new(0, 0, 0, 0, []);
    private string?            _fniDpmTodayError  = null;



    // Safety state
    private List<LccSafetyTblDto> _safetyIncidents  = new();
    private string?               _safetyLoadError  = null;

    // QRQC state
    private List<LccQrqcTicketDto> _qrqcTickets    = new();
    private string?                _qrqcLoadError  = null;

    private DateTime FiscalYearStart => DateTime.Now.Month >= 9
                                            ? new DateTime(DateTime.Now.Year, 9, 1)
                                            : new DateTime(DateTime.Now.Year - 1, 9, 1);
    private DateTime FiscalYearEnd   => FiscalYearStart.AddMonths(12).AddDays(-1);

    private IEnumerable<GroupItem> FilteredGroups =>
        string.IsNullOrWhiteSpace(_groupSearch)
            ? _groups
            : _groups.Where(g =>
                (g.Customer ?? "").Contains(_groupSearch, StringComparison.OrdinalIgnoreCase) ||
                (g.Division ?? "").Contains(_groupSearch, StringComparison.OrdinalIgnoreCase) ||
                (g.Family   ?? "").Contains(_groupSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        RefreshState.OnDpmTargetChanged += HandleDpmTargetChanged;
        _filter.DpmTarget = RefreshState.DpmTarget;
        await LoadBriefingStateAsync();
        await LoadGroupsAsync();
        StateHasChanged();
    }

    private void HandleDpmTargetChanged(int target)
    {
        _filter.DpmTarget = target;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadGroupsAsync()
    {
        _groupLoadError = null;
        _groupsLoading  = true;
        StateHasChanged();
        try
        {
            var result = await Sender.Send(new GetMotorolaGroupsQuery());
            if (result.IsFailure)
            {
                _groupLoadError = result.Error.Description;
            }
            else
            {
                _groups = result.Value
                    .Select(x => new GroupItem
                    {
                        Customer = x.CustomerName,
                        Division = x.DivisionText,
                        Family   = x.Family
                    })
                    .ToList();

                // Prepend ALL sentinel as first / default option
                var allSentinel = new GroupItem
                {
                    Customer = _groups.FirstOrDefault()?.Customer,
                    Division = null,
                    Family   = "ALL"
                };
                _groups.Insert(0, allSentinel);
                SelectGroup(allSentinel);
            }
        }
        catch (Exception ex)
        {
            _groupLoadError = $"Failed to load groups: {ex.Message}";
            Logger.LogError(ex, "Failed to load groups");
        }
        finally
        {
            _groupsLoading = false;
            StateHasChanged();
        }

        // Auto-select the currently running family after groups are loaded
        if (_groups.Count > 0 && _selectedGroup == null)
            await AutoSelectFamilyAsync();
    }

    private async Task AutoSelectFamilyAsync()
    {
        try
        {
            var result = await Sender.Send(new GetCurrentRunningFamilyQuery());
            if (result.IsFailure)
            {
                Logger.LogWarning("AutoSelectFamily: query failed — {Error}", result.Error.Description);
                return;
            }

            var (customer, division, family, shiftDate) = result.Value;
            Logger.LogInformation("AutoSelectFamily: mes_main returned customer={Customer} division={Division} family={Family} date={Date}",
                customer, division, family, shiftDate);

            if (family == null)
            {
                Logger.LogWarning("AutoSelectFamily: family is null, skipping");
                return;
            }

            // Auto-set the shift date from the most recent active record
            if (shiftDate.HasValue)
                OnDateChanged(shiftDate.Value);

            // Both sources now come from the same MES reference tables so the
            // family string matches exactly — no fuzzy comparison needed.
            var match = _groups.FirstOrDefault(g =>
                string.Equals(g.Family, family, StringComparison.OrdinalIgnoreCase));

            if (match != null)
                SelectGroup(match);
            else
            {
                Logger.LogWarning("AutoSelectFamily: no match in {Count} groups for family={Family} — falling back to ALL",
                    _groups.Count, family);
                var allFallback = _groups.FirstOrDefault(g => g.Family == "ALL");
                if (allFallback != null)
                    SelectGroup(allFallback);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto-select family failed");
        }
    }

    private void SelectGroup(GroupItem g)
    {
        _selectedGroup   = g;
        _filter.Customer = g.Customer;
        _filter.Division = g.Division;
        _filter.Family   = g.Family == "ALL" ? null : g.Family;
        StateHasChanged();
    }

    private void OnDateChanged(DateTime? date)
    {
        _selectedDate = date;
        if (date.HasValue)
            _filter.ShiftDate = DateOnly.FromDateTime(date.Value);
    }

    private async Task LaunchDashboard()
    {
        _initialized = true;
        RefreshState.SetDashboardActive(true);
        RefreshState.OnReconfigure       += HandleReconfigure;
        RefreshState.OnRefreshRequested  += HandleRefreshRequested;
        await LoadDataAsync(showLoading: true);
        StartClock();
        StateHasChanged();
    }

    private void ReOpenFilter()
    {
        _initialized     = false;
        _morningCard     = new() { Shift = "Morning" };
        _nightCard       = new() { Shift = "Night"   };
        _safetyIncidents = new();
        _safetyLoadError = null;
        _qrqcTickets     = new();
        _qrqcLoadError   = null;
        _selectedGroup   = null;
        _dataLoadError   = null;
        _fniYield        = new(0, 0, 0, 0, []);
        _fniLoadError    = null;
        _fniDpmToday     = new(0, 0, 0, 0, []);
        _fniDpmTodayError = null;
        StopClock();
        RefreshState.OnReconfigure      -= HandleReconfigure;
        RefreshState.OnRefreshRequested -= HandleRefreshRequested;
        RefreshState.SetDashboardActive(false);
        StateHasChanged();
    }

    private async Task HandleReconfigure()
    {
        await InvokeAsync(() =>
        {
            ReOpenFilter();
            StateHasChanged();
        });
    }

    private async Task HandleRefreshRequested()
    {
        await InvokeAsync(async () =>
        {
            // Reset the countdown so the progress arc restarts from 10 minutes
            _secondsUntilRefresh = RefreshIntervalSeconds;
            _refreshProgress     = 100;
            await LoadDataAsync(showLoading: false);
        });
    }

    private void StartClock()
    {
        StopClock();
        _secondsUntilRefresh = RefreshIntervalSeconds;
        _refreshProgress     = 100;

        _clockTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _currentTime = DateTime.Now;
                _secondsUntilRefresh--;
                _refreshProgress = _secondsUntilRefresh / (double)RefreshIntervalSeconds * 100;
                if (_secondsUntilRefresh <= 0)
                {
                    _secondsUntilRefresh = RefreshIntervalSeconds;
                    _refreshProgress     = 100;
                    if (!_isRefreshing)
                        await LoadDataAsync(showLoading: false);
                }

                // Detect shift change — reset briefing viewed state
                var currentKey = GetShiftKey();
                if (currentKey != _lastShiftKey)
                {
                    _lastShiftKey   = currentKey;
                    _briefingViewed = false;
                    try { await JS.InvokeVoidAsync("localStorage.removeItem", $"briefing_{_lastShiftKey}"); } catch { }
                }

                RefreshState.Update(
                    _refreshProgress,
                    _secondsUntilRefresh,
                    true,
                    _currentTime.ToString("HH:mm:ss"),
                    _currentTime.ToString("ddd, dd MMM yyyy").ToUpper());
                StateHasChanged();
            });
        }, null, 0, 1000);
    }

    private void StopClock()
    {
        _clockTimer?.Dispose();
        _clockTimer = null;
    }

    private Task LoadDataAsync() => LoadDataAsync(showLoading: true);

    private async Task LoadDataAsync(bool showLoading)
    {
        if (_isRefreshing) return;

        _isRefreshing  = true;
        _dataLoadError = null;

        if (showLoading)
        {
            _loading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            // ── Build all queries upfront ──────────────────────────────────
            var morningDate = _filter.ShiftDate;
            var nightDate   = _filter.ShiftDate.AddDays(-1);

            var safetyTask = Sender.Send(new GetSafetyIncidentsQuery(FiscalYearStart, FiscalYearEnd));
            var qrqcTask  = Sender.Send(new GetQrqcTicketsCurrentWeekQuery());

            var fniTask = !string.IsNullOrWhiteSpace(_filter.Customer)
                ? Sender.Send(new GetFniYieldWtdQuery(_filter.Customer!, _filter.Family))
                : Task.FromResult<LineControlCenter.Domain.Primitives.Result<FniYieldSummaryDto>>(
                    LineControlCenter.Domain.Primitives.Result.Success(new FniYieldSummaryDto(0, 0, 0, 0, [])));

            var fniDpmTodayTask = !string.IsNullOrWhiteSpace(_filter.Customer)
                ? Sender.Send(new GetFniDpmTodayQuery(_filter.Customer!, _filter.Family))
                : Task.FromResult<LineControlCenter.Domain.Primitives.Result<FniYieldSummaryDto>>(
                    LineControlCenter.Domain.Primitives.Result.Success(new FniYieldSummaryDto(0, 0, 0, 0, [])));


            var morningTask = Sender.Send(new GetBkTestDataQuery(
                string.IsNullOrEmpty(_filter.Customer) ? null : _filter.Customer,
                string.IsNullOrEmpty(_filter.Division) ? null : _filter.Division,
                string.IsNullOrEmpty(_filter.Family)   ? null : _filter.Family,
                null, "Morning", morningDate, morningDate));

            var nightTask = Sender.Send(new GetBkTestDataQuery(
                string.IsNullOrEmpty(_filter.Customer) ? null : _filter.Customer,
                string.IsNullOrEmpty(_filter.Division) ? null : _filter.Division,
                string.IsNullOrEmpty(_filter.Family)   ? null : _filter.Family,
                null, "Night", nightDate, nightDate));

            // ── Await all in parallel ──────────────────────────────────────
            await Task.WhenAll(safetyTask, qrqcTask, fniTask, fniDpmTodayTask, morningTask, nightTask);

            // ── Process safety result ──────────────────────────────────────
            var safetyResult = await safetyTask;
            if (safetyResult.IsSuccess)
            {
                _safetyIncidents = safetyResult.Value.ToList();
                _safetyLoadError = null;
            }
            else
            {
                _safetyLoadError = $"Safety data unavailable: {safetyResult.Error.Description}";
                Logger.LogWarning("Safety data unavailable: {Error}", safetyResult.Error.Description);
            }

            // ── Process QRQC result ───────────────────────────────────────────
            var qrqcResult = await qrqcTask;
            if (qrqcResult.IsSuccess)
            {
                _qrqcTickets   = qrqcResult.Value.ToList();
                _qrqcLoadError = null;
            }
            else
            {
                _qrqcTickets   = new();
                _qrqcLoadError = $"QRQC data unavailable: {qrqcResult.Error.Description}";
                Logger.LogWarning("QRQC data unavailable: {Error}", qrqcResult.Error.Description);
            }

            // ── Process FNI result ─────────────────────────────────────────────────
            var fniResult = await fniTask;
            if (fniResult.IsSuccess)
            {
                _fniYield     = fniResult.Value;
                _fniLoadError = null;
            }
            else
            {
                _fniYield     = new(0, 0, 0, 0, []);
                _fniLoadError = $"FNI data unavailable: {fniResult.Error.Description}";
                Logger.LogWarning("FNI data unavailable: {Error}", fniResult.Error.Description);
            }



            // ── Process FNI DPM Today result ───────────────────────────────────
            var fniDpmTodayResult = await fniDpmTodayTask;
            if (fniDpmTodayResult.IsSuccess)
            {
                _fniDpmToday      = fniDpmTodayResult.Value;
                _fniDpmTodayError = null;
            }
            else
            {
                _fniDpmToday      = new(0, 0, 0, 0, []);
                _fniDpmTodayError = $"FNI DPM (Today) unavailable: {fniDpmTodayResult.Error.Description}";
                Logger.LogWarning("FNI DPM Today unavailable: {Error}", fniDpmTodayResult.Error.Description);
            }

            // NOTE: NCR/CAR/JCAS compliance data is owned by <NcrCarSummaryPanel/>.
            // Loading it here too caused concurrent DbContext access on the same circuit
            // ("A second operation was started on this context instance...").

            // ── Process shift card results ─────────────────────────────────
            var morningResult = await morningTask;
            _morningCard = new CardModel
            {
                Family     = _filter.Family,
                Customer   = _filter.Customer,
                Division   = _filter.Division,
                Shift      = "Morning",
                ShiftDate  = morningDate.ToString("MM/dd/yyyy"),
                PlannedQty = _filter.FniPlannedQty,
                Records    = morningResult.IsSuccess ? morningResult.Value.ToList() : []
            };

            var nightResult = await nightTask;
            _nightCard = new CardModel
            {
                Family     = _filter.Family,
                Customer   = _filter.Customer,
                Division   = _filter.Division,
                Shift      = "Night",
                ShiftDate  = nightDate.ToString("MM/dd/yyyy"),
                PlannedQty = _filter.FniPlannedQty,
                Records    = nightResult.IsSuccess ? nightResult.Value.ToList() : []
            };

            _lastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            _dataLoadError = $"Failed to load data: {ex.Message}";
            Logger.LogError(ex, "Failed to load dashboard data");
        }
        finally
        {
            _isRefreshing = false;
            if (showLoading)
                _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


@using LineControlCenter.Application.DTOs
@using MudBlazor
@inject IJSRuntime JS

<MudDialog Style="background:#0a1628; border-radius:20px; overflow:hidden;">
    <DialogContent>
        <div style="display:flex; flex-direction:column; height:82vh; max-height:82vh;">
            <div style="display:flex; align-items:center; justify-content:space-between;
                        padding:20px 24px 14px; flex-shrink:0;
                        background:linear-gradient(135deg,#0d1f3c 0%,#0a1628 100%);
                        border-bottom:1px solid #1a3a5c;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:42px; height:42px; border-radius:12px;
                                background:linear-gradient(135deg,#00d4ff20,#00d4ff08);
                                border:1px solid #00d4ff44;
                                display:flex; align-items:center; justify-content:center;">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Style="color:#00d4ff; font-size:22px;" />
                    </div>
                    <div>
                        <div style="color:#00d4ff; font-family:'Orbitron',sans-serif;
                                    font-size:14px; font-weight:800; letter-spacing:2px;">
                            FNI YIELD · WTD DETAILS
                        </div>
                        <div style="display:flex; align-items:center; gap:8px; margin-top:2px; flex-wrap:wrap;">
                            <span style="color:#7ab3cc; font-size:10px;">@Customer</span>
                            <span style="color:#3d6b8a;">·</span>
                            <span style="color:#7ab3cc; font-size:10px;">@Family</span>
                            <span style="color:#3d6b8a;">·</span>
                            <span style="color:@_yieldColor; font-size:10px; font-weight:700;">@Summary.YieldRate.ToString("F2")%</span>
                            <span style="color:#3d6b8a;">·</span>
                            <span style="color:#7ab3cc; font-size:10px; letter-spacing:1px;">
                                @_wtdStart.ToString("MM/dd/yyyy") – @_wtdEnd.ToString("MM/dd/yyyy")
                            </span>
                        </div>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="MudSize.Small"
                               Style="color:#e8f4f8; background:#0d1f3c; border:1px solid #1a3a5c;
                                      border-radius:10px; width:36px; height:36px;"
                               OnClick="Cancel" />
            </div>

            <div style="flex:1; overflow-y:auto; padding:16px 24px 20px;">
                <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; flex-wrap:wrap;">
                    <MudTextField @bind-Value="_searchText"
                                  Placeholder="Search serial, status, family..."
                                  Variant="MudVariant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="250"
                                  Style="max-width:340px; font-size:12px;" />
                    <div style="display:flex; gap:8px;">
                        <MudButton Variant="MudVariant.Outlined" Size="MudSize.Small"
                                   StartIcon="@Icons.Material.Filled.TableChart"
                                   Style="border-color:#00ff8833; color:#00ff88; border-radius:8px;"
                                   OnClick="ExportToExcel">EXCEL</MudButton>
                        <MudButton Variant="MudVariant.Outlined" Size="MudSize.Small"
                                   StartIcon="@Icons.Material.Filled.Description"
                                   Style="border-color:#00d4ff33; color:#00d4ff; border-radius:8px;"
                                   OnClick="ExportToCsv">CSV</MudButton>
                    </div>
                </div>

                <MudDataGrid T="FniYieldDetailDto"
                             Items="FilteredDetails"
                             SortMode="SortMode.Multiple"
                             Dense="true"
                             Hover="true"
                             RowsPerPage="25"
                             Style="background:#0d1a2e; border:1px solid #0d2137; border-radius:14px; overflow:hidden;">
                    <Columns>
                        <PropertyColumn Property="x => x.SerialNumber" Title="Serial #"
                                        CellStyle="color:#e0eaf8; font-family:monospace; font-size:12px;" />
                        <PropertyColumn Property="x => x.EndTime" Title="Date" Format="MM/dd/yyyy HH:mm"
                                        CellStyle="color:#8899aa; font-family:monospace; font-size:11px;" />
                        <TemplateColumn Title="Status" SortBy="x => x.Status">
                            <CellTemplate>
                                @{
                                    var isPass = string.Equals(context.Item.Status, "Pass", StringComparison.OrdinalIgnoreCase);
                                    var sc = isPass ? "#00ff88" : "#ff4444";
                                }
                                <div style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px;
                                            border-radius:12px; background:@(sc)15; border:1px solid @(sc)44;">
                                    <div style="width:6px; height:6px; border-radius:50%; background:@sc;"></div>
                                    <span style="color:@sc; font-size:10px; font-weight:700; letter-spacing:1px;">@context.Item.Status</span>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.CustomerName" Title="Customer"
                                        CellStyle="color:#e0eaf8; font-size:12px;" />
                        <PropertyColumn Property="x => x.Family" Title="Family"
                                        CellStyle="color:#e0eaf8; font-size:12px;" />
                        <PropertyColumn Property="x => x.StepInstance" Title="Step"
                                        CellStyle="color:#00d4ff; font-size:12px; font-weight:700;" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="FniYieldDetailDto" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public FniYieldSummaryDto Summary { get; set; } = new(0, 0, 0, 0, []);
    [Parameter] public string Customer { get; set; } = string.Empty;
    [Parameter] public string Family { get; set; } = string.Empty;

    private string _searchText = string.Empty;

    private static DateTime _wtdStart => GetWeekStart(DateTime.Today);
    private static DateTime _wtdEnd   => DateTime.Today;

    private static DateTime GetWeekStart(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }

    private string _yieldColor => Summary.YieldRate >= 98 ? "#00ff88"
                                : Summary.YieldRate >= 90 ? "#ffaa00"
                                                          : "#ff4444";

    private IEnumerable<FniYieldDetailDto> FilteredDetails =>
        string.IsNullOrWhiteSpace(_searchText)
            ? Summary.Details
            : Summary.Details.Where(x =>
                (x.SerialNumber ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.Status ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.CustomerName ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.Family ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.StepInstance ?? string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private void Cancel() => MudDialog.Cancel();

    private async Task ExportToCsv()
    {
        var rows = FilteredDetails.ToList();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Serial Number,End Time,Status,Customer,Family,Step Instance");

        foreach (var r in rows)
        {
            sb.AppendLine($"\"{E(r.SerialNumber)}\",\"{r.EndTime:MM/dd/yyyy HH:mm}\",\"{E(r.Status)}\",\"{E(r.CustomerName)}\",\"{E(r.Family)}\",\"{E(r.StepInstance)}\"");
        }

        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
        await JS.InvokeVoidAsync("lccDownloadFile", $"LCC_FNI_{DateTime.Now:yyyyMMdd_HHmmss}.csv", b64, "text/csv");
    }

    private async Task ExportToExcel()
    {
        var rows = FilteredDetails.ToList();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Serial Number\tEnd Time\tStatus\tCustomer\tFamily\tStep Instance");

        foreach (var r in rows)
        {
            sb.AppendLine($"{r.SerialNumber}\t{r.EndTime:MM/dd/yyyy HH:mm}\t{r.Status}\t{r.CustomerName}\t{r.Family}\t{r.StepInstance}");
        }

        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
        await JS.InvokeVoidAsync("lccDownloadFile", $"LCC_FNI_{DateTime.Now:yyyyMMdd_HHmmss}.xls", b64, "application/vnd.ms-excel");
    }

    private static string E(string? v) => (v ?? string.Empty).Replace("\"", "\"\"");
}

@using LineControlCenter.Application.DTOs
@using LineControlCenter.UI.Models
@using MudBlazor

<MudDialog Style="background:#0a1628; border-radius:20px; overflow:hidden;">
    <DialogContent>
        <div style="display:flex; flex-direction:column; height:82vh; max-height:82vh;">

            @* ── Header ── *@
            <div style="display:flex; align-items:center; justify-content:space-between;
                        padding:20px 28px 16px; flex-shrink:0;
                        background:linear-gradient(135deg,#0d1f3c 0%,#0a1628 100%);
                        border-bottom:1px solid #1a3a5c;">
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:46px; height:46px; border-radius:14px;
                                background:linear-gradient(135deg,@(_shiftColor)20,@(_shiftColor)08);
                                border:1px solid @(_shiftColor)44;
                                display:flex; align-items:center; justify-content:center;
                                box-shadow:0 0 20px @(_shiftColor)15;">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                 Style="@($"color:{_shiftColor}; font-size:24px;")" />
                    </div>
                    <div>
                        <div style="color:@_shiftColor; font-family:'Orbitron',sans-serif;
                                    font-size:15px; font-weight:800; letter-spacing:3px; margin-bottom:3px;">
                            @Card.Shift.ToUpper() SHIFT &nbsp;·&nbsp; BY PROCESS
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="background:@(_shiftColor)15; border:1px solid @(_shiftColor)30;
                                         color:@_shiftColor; font-size:10px; letter-spacing:1px;
                                         padding:2px 10px; border-radius:20px; font-weight:600;">
                                @Card.ShiftDate
                            </span>
                            <span style="color:#7ab3cc; font-size:10px;">@Card.Customer</span>
                            <span style="color:#3d6b8a;">·</span>
                            <span style="color:#7ab3cc; font-size:10px;">@Card.Division</span>
                            <span style="color:#3d6b8a;">·</span>
                            <span style="color:#7ab3cc; font-size:10px;">@Card.Family</span>
                        </div>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="MudSize.Small"
                               Style="color:#e8f4f8; background:#0d1f3c; border:1px solid #1a3a5c;
                                      border-radius:10px; width:36px; height:36px;"
                               OnClick="Cancel" />
            </div>

            @* ── Summary KPI Strip ── *@
            <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px;
                        padding:16px 28px 0; flex-shrink:0;">
                @{
                    var totalTested = _rows.Sum(r => r.Tested);
                    var totalPass   = _rows.Sum(r => r.Pass);
                    var totalFail   = _rows.Sum(r => r.Fail);
                    var totalYield  = totalTested > 0
                        ? Math.Round(totalPass / (double)totalTested * 100, 1)
                        : 0.0;
                    var overallColor = totalYield >= 98 ? "#22c55e" : totalYield >= 90 ? "#f59e0b" : "#ff3b3b";
                }
                @KpiBox(Icons.Material.Filled.Category, "PROCESSES", _rows.Count.ToString(), "#00d4ff")
                @KpiBox(Icons.Material.Filled.CheckCircle, "TOTAL PASS", totalPass.ToString("N0"), "#22c55e")
                @KpiBox(Icons.Material.Filled.Cancel, "TOTAL FAIL", totalFail.ToString("N0"), "#ff3b3b")
                @KpiBox(Icons.Material.Filled.Percent, "OVERALL YIELD", totalYield + "%", overallColor)
            </div>

            @* ── Scrollable Body ── *@
            <div style="flex:1; overflow-y:auto; padding:16px 28px 24px;">

                @if (!_rows.Any())
                {
                    <div style="display:flex; flex-direction:column; align-items:center;
                                justify-content:center; height:300px; gap:12px;">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                                 Style="color:#1a3a5c; font-size:56px;" />
                        <div style="color:#3d6b8a; font-size:13px; letter-spacing:1px;">No data for this shift</div>
                    </div>
                }
                else
                {
                    @* ── Process Breakdown Cards ── *@
                    <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:20px;">
                        @foreach (var row in _rows.OrderByDescending(r => r.Tested))
                        {
                            var yieldColor = row.YieldRate >= 98 ? "#22c55e"
                                           : row.YieldRate >= 90 ? "#f59e0b"
                                                                  : "#ff3b3b";
                            var actualPct  = row.Planned > 0
                                ? Math.Min(Math.Round(row.Pass / (double)row.Planned * 100, 1), 200.0)
                                : 0.0;
                            var planColor  = actualPct >= 100 ? "#22c55e"
                                           : actualPct >= 80  ? "#f59e0b"
                                                              : "#ff3b3b";
                            var yieldBarW  = row.YieldRate.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            var planBarW   = Math.Min(actualPct, 100.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

                            <div style="background:#0d1f3c; border:1px solid #1a3a5c;
                                        border-left:3px solid @(yieldColor);
                                        border-radius:12px; padding:14px 18px;
                                        transition:border-color 0.2s;">

                                @* Process name row *@
                                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <div style="width:30px; height:30px; border-radius:8px;
                                                    background:@(_shiftColor)18; border:1px solid @(_shiftColor)33;
                                                    display:flex; align-items:center; justify-content:center;">
                                            <MudIcon Icon="@Icons.Material.Filled.Memory"
                                                     Style="@($"color:{_shiftColor}; font-size:15px;")" />
                                        </div>
                                        <span style="color:#e8f4f8; font-family:'Orbitron',sans-serif;
                                                     font-size:12px; font-weight:700; letter-spacing:1px;">
                                            @(string.IsNullOrWhiteSpace(row.Process) ? "UNKNOWN" : row.Process.ToUpper())
                                        </span>
                                    </div>
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        <div style="padding:3px 10px; border-radius:20px;
                                                    background:@(yieldColor)18; border:1px solid @(yieldColor)44;">
                                            <span style="color:@yieldColor; font-size:10px; font-weight:700; letter-spacing:1px;">
                                                @row.YieldRate%&nbsp;YIELD
                                            </span>
                                        </div>
                                        <div style="padding:3px 10px; border-radius:20px;
                                                    background:@(planColor)18; border:1px solid @(planColor)44;">
                                            <span style="color:@planColor; font-size:10px; font-weight:700; letter-spacing:1px;">
                                                @actualPct%&nbsp;PLAN
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                @* Stats + bars grid *@
                                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">

                                    @* Yield (RTY) *@
                                    <div>
                                        <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
                                            <span style="color:#7ab3cc; font-size:9px; letter-spacing:2px; font-weight:700;">YIELD (RTY)</span>
                                            <div style="display:flex; gap:12px;">
                                                <span style="color:#22c55e; font-size:9px; font-weight:700;">
                                                    ✓ @row.Pass PASS
                                                </span>
                                                <span style="color:#ff3b3b; font-size:9px; font-weight:700;">
                                                    ✗ @row.Fail FAIL
                                                </span>
                                                <span style="color:#7ab3cc; font-size:9px;">
                                                    / @row.Tested TESTED
                                                </span>
                                            </div>
                                        </div>
                                        <div style="height:8px; background:#0a1628; border-radius:4px; overflow:hidden; margin-bottom:4px;">
                                            <div style="height:100%;
                                                        width:@(yieldBarW)%;
                                                        background:linear-gradient(90deg,@yieldColor,@(yieldColor)99);
                                                        border-radius:4px; transition:width 0.7s ease;">
                                            </div>
                                        </div>
                                        <div style="display:flex; justify-content:space-between;">
                                            <span style="color:#3d6b8a; font-size:8px;">0%</span>
                                            <span style="color:@yieldColor; font-size:10px; font-weight:800;
                                                         font-family:'Orbitron',sans-serif;">@row.YieldRate%</span>
                                            <span style="color:#3d6b8a; font-size:8px;">100%</span>
                                        </div>
                                    </div>

                                    @* Plan vs Actual *@
                                    <div>
                                        <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
                                            <span style="color:#7ab3cc; font-size:9px; letter-spacing:2px; font-weight:700;">PLAN VS ACTUAL</span>
                                            <div style="display:flex; gap:12px;">
                                                <span style="color:#e8f4f8; font-size:9px; font-weight:700;">
                                                    @row.Pass ACTUAL
                                                </span>
                                                <span style="color:#7ab3cc; font-size:9px;">
                                                    / @row.Planned TARGET
                                                </span>
                                            </div>
                                        </div>
                                        <div style="height:8px; background:#0a1628; border-radius:4px; overflow:hidden; margin-bottom:4px;">
                                            <div style="height:100%;
                                                        width:@(planBarW)%;
                                                        background:linear-gradient(90deg,@planColor,@(planColor)99);
                                                        border-radius:4px; transition:width 0.7s ease;">
                                            </div>
                                        </div>
                                        <div style="display:flex; justify-content:space-between;">
                                            <span style="color:#3d6b8a; font-size:8px;">0</span>
                                            <span style="color:@planColor; font-size:10px; font-weight:800;
                                                         font-family:'Orbitron',sans-serif;">@actualPct%</span>
                                            <span style="color:#3d6b8a; font-size:8px;">@row.Planned</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── Summary Table ── *@
                    <div style="background:#0d1f3c; border:1px solid #1a3a5c; border-radius:14px; overflow:hidden;">
                        <div style="padding:12px 18px; border-bottom:1px solid #1a3a5c;
                                    display:flex; align-items:center; gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.TableView" Style="color:#00d4ff; font-size:15px;" />
                            <span style="color:#00d4ff; font-size:9px; font-weight:700; letter-spacing:2px;">PROCESS SUMMARY TABLE</span>
                        </div>
                        <div style="overflow-x:auto;">
                            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                <thead>
                                    <tr style="background:#0a1628;">
                                        <th style="padding:8px 14px; text-align:left; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">PROCESS</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">PLANNED</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">TESTED</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">PASS</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">FAIL</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">YIELD</th>
                                        <th style="padding:8px 14px; text-align:right; color:#7ab3cc;
                                                   font-size:8px; letter-spacing:2px; font-weight:700;
                                                   border-bottom:1px solid #1a3a5c;">PLAN %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _rows.OrderByDescending(r => r.Tested))
                                    {
                                        var yc = row.YieldRate >= 98 ? "#22c55e" : row.YieldRate >= 90 ? "#f59e0b" : "#ff3b3b";
                                        var ap = row.Planned > 0
                                            ? Math.Round(row.Pass / (double)row.Planned * 100, 1)
                                            : 0.0;
                                        var pc = ap >= 100 ? "#22c55e" : ap >= 80 ? "#f59e0b" : "#ff3b3b";
                                        <tr style="border-bottom:1px solid #1a3a5c20;
                                                   transition:background 0.15s;"
                                            onmouseover="this.style.background='#1a3a5c30'"
                                            onmouseout="this.style.background='transparent'">
                                            <td style="padding:9px 14px; color:#e8f4f8; font-weight:600; font-size:12px;">
                                                @(string.IsNullOrWhiteSpace(row.Process) ? "Unknown" : row.Process)
                                            </td>
                                            <td style="padding:9px 14px; text-align:right; color:#7ab3cc; font-family:monospace;">@row.Planned</td>
                                            <td style="padding:9px 14px; text-align:right; color:#e8f4f8; font-family:monospace; font-weight:700;">@row.Tested</td>
                                            <td style="padding:9px 14px; text-align:right; color:#22c55e; font-family:monospace; font-weight:700;">@row.Pass</td>
                                            <td style="padding:9px 14px; text-align:right; color:#ff3b3b; font-family:monospace; font-weight:700;">@row.Fail</td>
                                            <td style="padding:9px 14px; text-align:right;">
                                                <span style="color:@yc; font-family:'Orbitron',monospace; font-size:12px; font-weight:800;">@row.YieldRate%</span>
                                            </td>
                                            <td style="padding:9px 14px; text-align:right;">
                                                <span style="color:@pc; font-family:'Orbitron',monospace; font-size:12px; font-weight:800;">@ap%</span>
                                            </td>
                                        </tr>
                                    }
                                    @* Totals row *@
                                    <tr style="background:#0a1628; border-top:2px solid #1a3a5c;">
                                        <td style="padding:10px 14px; color:#00d4ff; font-weight:800; font-size:12px; letter-spacing:1px;">TOTAL</td>
                                        <td style="padding:10px 14px; text-align:right; color:#7ab3cc; font-family:monospace; font-weight:700;">@Card.PlannedQty</td>
                                        <td style="padding:10px 14px; text-align:right; color:#e8f4f8; font-family:monospace; font-weight:700;">@totalTested</td>
                                        <td style="padding:10px 14px; text-align:right; color:#22c55e; font-family:monospace; font-weight:700;">@totalPass</td>
                                        <td style="padding:10px 14px; text-align:right; color:#ff3b3b; font-family:monospace; font-weight:700;">@totalFail</td>
                                        <td style="padding:10px 14px; text-align:right;">
                                            <span style="color:@overallColor; font-family:'Orbitron',monospace; font-size:12px; font-weight:800;">@totalYield%</span>
                                        </td>
                                        <td style="padding:10px 14px; text-align:right;">
                                            @{
                                                var overallPlan = Card.PlannedQty > 0
                                                    ? Math.Round(totalPass / (double)Card.PlannedQty * 100, 1)
                                                    : 0.0;
                                                var opColor = overallPlan >= 100 ? "#22c55e" : overallPlan >= 80 ? "#f59e0b" : "#ff3b3b";
                                            }
                                            <span style="color:@opColor; font-family:'Orbitron',monospace; font-size:12px; font-weight:800;">@overallPlan%</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public CardModel Card { get; set; } = new();

    private string _shiftColor => Card.Shift == "Morning" ? "#00e5c0" : "#60a5fa";

    private record ProcessRow(string? Process, int Planned, int Tested, int Pass, int Fail, double YieldRate);

    private List<ProcessRow> _rows = new();

    protected override void OnParametersSet()
    {
        _rows = Card.Records
            .Where(x => x.TestLoopCount == null || x.TestLoopCount == 1)
            .GroupBy(x => x.Process)
            .Select(g =>
            {
                var tested = g.Count();
                var pass   = g.Count(x => x.TestStatus == "P");
                var fail   = tested - pass;
                var yield  = tested > 0 ? Math.Round(pass / (double)tested * 100, 1) : 0.0;
                return new ProcessRow(g.Key, Card.PlannedQty, tested, pass, fail, yield);
            })
            .ToList();
    }

    private RenderFragment KpiBox(string icon, string label, string value, string color) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", $"background:#0b1422; border:1px solid #1a3a5c; border-radius:10px; padding:10px 14px; position:relative; overflow:hidden;");
        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "style", $"position:absolute; top:0; left:0; right:0; height:1.5px; background:linear-gradient(90deg,transparent,{color},transparent); opacity:0.6;");
        __builder.CloseElement();
        __builder.OpenComponent<MudIcon>(4);
        __builder.AddAttribute(5, "Icon", icon);
        __builder.AddAttribute(6, "Style", $"color:{color}; font-size:13px; margin-bottom:5px;");
        __builder.CloseComponent();
        __builder.OpenElement(7, "div");
        __builder.AddAttribute(8, "style", "color:#667788; font-size:8px; letter-spacing:2px; font-weight:700; margin-bottom:3px;");
        __builder.AddContent(9, label);
        __builder.CloseElement();
        __builder.OpenElement(10, "div");
        __builder.AddAttribute(11, "style", $"color:{color}; font-size:16px; font-weight:800; font-family:'Orbitron',monospace; line-height:1;");
        __builder.AddContent(12, value);
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private void Cancel() => MudDialog.Cancel();
}

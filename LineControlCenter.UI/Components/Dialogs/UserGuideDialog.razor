@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _searchText    = string.Empty;
    private string _activeSection = "intro";

    private record SectionDef(string Id, string Icon, string Title, string Color, string[] Keywords);

    private readonly List<SectionDef> _sections =
    [
        new("intro",     Icons.Material.Filled.Info,             "Overview",             "#00b4d8", ["overview","about","intro","dashboard","mes","lcc","what","source"]),
        new("howto",     Icons.Material.Filled.Tune,             "How to Use",           "#00b4d8", ["how","use","configure","launch","toolbar","refresh","planned","shift date","feedback","step"]),
        new("topbar",    Icons.Material.Filled.Dashboard,        "Top Bar Controls",     "#00e5c0", ["top bar","appbar","toolbar","dpm","target","refresh","zoom","screen zoom","reconfigure","settings","button"]),
        new("briefing",  Icons.Material.Filled.CastForEducation, "Briefing",             "#22c55e", ["briefing","shift","daily","supervisor","badge","green","viewed","confirm","message","note","announcement"]),
        new("safety",    Icons.Material.Filled.HealthAndSafety,  "Safety Card",          "#f59e0b", ["safety","incident","days","fiscal","milestone","recordable","trend","all clear","monitor","alert","lcc","sep","aug"]),
        new("fni",       Icons.Material.Filled.Speed,            "FNI Yield",            "#00d4ff", ["fni","final","numeric","inspection","wtd","week","route","pass","fail","yield","loop","mes","monday"]),
        new("fniplan",   Icons.Material.Filled.Speed,            "FNI Plan vs Actual",   "#a78bfa", ["fni","planned","actual","target","plan","attainment","weekly","qty","purple","gap"]),
        new("ncr",       Icons.Material.Filled.AssignmentLate,   "NCR / CAR",            "#a78bfa", ["ncr","car","jcas","compliance","corrective","non-conformance","d7","closed","open","age","bay","category","8d"]),
        new("livepanels",Icons.Material.Filled.Videocam,         "Live Panels",          "#00d4ff", ["live","camera","soms","backend","bay","iframe","risk","learning","zoom","scale","feed","stream"]),
        new("gauges",    Icons.Material.Filled.DonutSmall,       "Gauges & Visuals",     "#00e5c0", ["gauge","chart","visual","half circle","badge","color","trend","arrow","status","arc","countdown"]),
        new("drilldown", Icons.Material.Filled.OpenInFull,       "Drill-Down Dialogs",   "#00e5c0", ["drill","detail","dialog","search","export","excel","csv","table","column","filter","records"]),
    ];

    private void SetSection(string id) => _activeSection = id;

    private bool SectionVisible(string id)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return _activeSection == id;
        var sec = _sections.FirstOrDefault(s => s.Id == id);
        return sec is not null &&
               sec.Keywords.Any(k => k.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
    }

    private void Close() => MudDialog.Close();
}

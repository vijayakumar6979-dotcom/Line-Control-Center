            @* ------------------------------------------
               SAFETY CARD
               ------------------------------------------ *@
            @if (SectionVisible("safety"))
            {
                <div id="sec-safety" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.HealthAndSafety, "SAFETY CARD", "Fiscal year incident tracking -- amber accent", "#f59e0b"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
                        <div>
                            @{ InfoBox(Icons.Material.Filled.Storage, "WHERE THE DATA COMES FROM",
                                "Safety incident records are stored in the LCC database in a table called 'Safety Incidents'. " +
                                "When the dashboard loads, it fetches all rows where the incident date falls within the current fiscal year. " +
                                "The fiscal year runs from September 1 through August 31 each year. " +
                                "For example, if today is June 2025, the system loads all incidents from September 1, 2024 to today.",
                                "#f59e0b"); }

                            @{ InfoBox(Icons.Material.Filled.FilterAlt, "HOW THE DATA IS FILTERED",
                                "No shift, product family, or customer filter is applied to safety data -- it shows incidents for the entire site. " +
                                "The only filter is the fiscal year date range. Every record with an incident timestamp on or after September 1 of the current fiscal year is included.",
                                "#f59e0b"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:4px;">BADGE STATUS EXPLAINED</div>
                            @{ ThresholdRow("* ALL CLEAR", "90 or more days have passed since the last incident. The team is maintaining a strong safety streak.", "#22c55e"); }
                            @{ ThresholdRow("* MONITOR",   "Between 30 and 89 days since the last incident. Good progress but not yet at the 90-day milestone.", "#f59e0b"); }
                            @{ ThresholdRow("* ALERT",     "Fewer than 30 days since the last incident. Recent incident -- attention and follow-up required.", "#ff3b3b"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:12px;">MILESTONE PROGRESS BAR</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.8;">
                                The horizontal bar at the centre of the card tracks progress through four milestone targets:
                                <span style="color:#f59e0b;">30 days -> 90 days -> 180 days -> 365 days</span>.
                                Each dot on the bar lights up solid when that milestone is reached.
                                The bar itself fills from left to right, where the full width represents 365 days.
                                A hint below the bar tells you how many days remain until the next milestone.
                            </div>
                        </div>
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">HOW EACH NUMBER IS CALCULATED</div>

                            @{ CalcBox("Days Without Incident",
                                "Today's date  ->  Date of the last recorded incident",
                                "The system finds the most recent incident in the fiscal year data and counts the number of calendar days between that date and today. " +
                                "If there are zero incidents this fiscal year, the counter instead shows how many days have passed since September 1 (the fiscal year start date). " +
                                "Example: last incident was March 15 and today is June 14 -> 91 days without incident.",
                                "#f59e0b"); }

                            @{ CalcBox("FY Incidents (total count)",
                                "Count of all incident rows with a date = September 1",
                                "Every incident that happened from September 1 of the current fiscal year up to today is counted. " +
                                "This total does not filter by type, severity, or recordable status -- all incident records are included.",
                                "#f59e0b"); }

                            @{ CalcBox("Last 30 Days",
                                "Count of incidents where the date is within the past 30 days",
                                "A rolling window: incidents that occurred from exactly 30 days ago up to today. " +
                                "This number updates daily so it always reflects the most recent month of activity.",
                                "#f59e0b"); }

                            @{ CalcBox("Trend (vs previous 30 days)",
                                "Last-30-days count  ->  previous-30-days count",
                                "The system also counts incidents from 31 to 60 days ago (the prior period). " +
                                "If recent 30 days had more incidents -> red arrow (worsening). " +
                                "If fewer -> green arrow (improving). If the same -> grey flat arrow (stable). " +
                                "Example: 0 recent vs 1 previous = -1 -> green improving arrow.",
                                "#f59e0b"); }

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:4px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">* WORKED EXAMPLE</div>
                                @{ ExRow("Fiscal year start",        "Sep 1, 2024",   "#e8f4f8"); }
                                @{ ExRow("Last incident date",        "Mar 15, 2025",  "#f59e0b"); }
                                @{ ExRow("Today",                     "Jun 14, 2025",  "#e8f4f8"); }
                                @{ ExRow("Days without incident",     "91 days",       "#22c55e"); }
                                @{ ExRow("Badge",                     "ALL CLEAR --",   "#22c55e"); }
                                @{ ExRow("Total FY incidents",        "2",             "#f59e0b"); }
                                @{ ExRow("Last 30 days incidents",    "0",             "#22c55e"); }
                                @{ ExRow("Previous 30 days",         "1",             "#f59e0b"); }
                                @{ ExRow("Trend",                    "-1 (IMPROVING)","#22c55e"); }
                            </div>

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:10px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:6px;">SAFETY DETAILS DRILL-DOWN</div>
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    Click the <span style="color:#f59e0b; font-weight:700;">SAFETY DETAILS</span> button at the bottom of the card
                                    to open a full table of every incident in the fiscal year. You can search across all columns,
                                    sort by any column, and export the list to Excel or CSV for offline review.
                                    Columns include: incident date, site, segment, sector, type, severity, injury classification, recordable flag, lost-time days, and more.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               FNI YIELD CARD
               ------------------------------------------ *@
            @if (SectionVisible("fni"))
            {
                <div id="sec-fni" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.Speed, "FNI YIELD CARD", "Final Numeric Inspection -- Week to Date pass rate -- cyan accent", "#00d4ff"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
                        <div>
                            @{ InfoBox(Icons.Material.Filled.Storage, "WHERE THE DATA COMES FROM",
                                "FNI data comes from the MES (Manufacturing Execution System) database. " +
                                "The system looks at the main test results table and filters it down to only the rows that belong to the FNI inspection step. " +
                                "It also cross-references a route-steps table to confirm the step is specifically an FNI-type step, " +
                                "and a customer table to make sure the records belong to your selected customer.",
                                "#00d4ff"); }

                            @{ InfoBox(Icons.Material.Filled.FilterAlt, "HOW THE DATA IS FILTERED",
                                "Four filters are applied together to find the right records:\n" +
                                "1. Customer -- only records for your selected customer (e.g. Motorola) are included.\n" +
                                "2. Product Family -- only the family you chose on the configure screen.\n" +
                                "3. Route Step = FNI -- only test records where the inspection step is the Final Numeric Inspection step. Other steps like SMT or ICT are excluded.\n" +
                                "4. Date range = this week -- only records from Monday of the current calendar week through to today are counted. The window resets every Monday morning.",
                                "#00d4ff"); }

                            @{ InfoBox(Icons.Material.Filled.Info, "WHAT 'TEST LOOP = 1' MEANS",
                                "The FNI query also filters to only first-loop test runs. A unit may be tested more than once if it fails and is re-submitted. " +
                                "Loop = 1 means the very first time the unit went through FNI, not a re-test. " +
                                "This ensures the yield reflects genuine first-pass quality, not the result after repair.",
                                "#00d4ff"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:4px;">BADGE STATUS EXPLAINED</div>
                            @{ ThresholdRow("* ON TARGET", "FNI Yield is 98% or above. First-pass quality is meeting the standard.", "#22c55e"); }
                            @{ ThresholdRow("* MONITOR",   "FNI Yield is between 90% and 97.99%. Quality needs attention.", "#f59e0b"); }
                            @{ ThresholdRow("* AT RISK",   "FNI Yield is below 90%. Significant quality issue -- escalation advised.", "#ff3b3b"); }
                        </div>
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">HOW EACH NUMBER IS CALCULATED</div>

                            @{ CalcBox("Total Tested (WTD)",
                                "Count of all FNI step records from Monday to today",
                                "Every unit that went through the FNI inspection step from the start of this calendar week (Monday) up to right now is counted here. " +
                                "This is your denominator -- the total pool of units inspected at FNI this week.",
                                "#00d4ff"); }

                            @{ CalcBox("Pass Count",
                                "Count where the FNI test result = 'PASS'",
                                "Only units whose FNI result is exactly 'PASS' are counted. " +
                                "Units that resulted in FAIL, ABORT, or any other outcome are not counted as a pass. " +
                                "This is your numerator.",
                                "#00d4ff"); }

                            @{ CalcBox("Fail Count",
                                "Total Tested  ->  Pass Count",
                                "The number of units that did not achieve a PASS result at FNI this week. Includes all non-passing outcomes.",
                                "#00d4ff"); }

                            @{ CalcBox("FNI Yield %",
                                "(Pass Count / Total Tested) -- 100  -- shown to 2 decimal places",
                                "The percentage of all FNI-tested units this week that passed on their first run through the inspection step. " +
                                "Displayed to two decimal places (e.g. 99.03%) so small changes are visible. " +
                                "This is the headline number shown in the half-circle gauge.",
                                "#00d4ff"); }

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:4px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">* WORKED EXAMPLE (Monday to Thursday)</div>
                                @{ ExRow("Customer",              "Motorola",  "#e8f4f8"); }
                                @{ ExRow("Family",                "G85",       "#e8f4f8"); }
                                @{ ExRow("Week start",            "Mon Jun 9", "#e8f4f8"); }
                                @{ ExRow("Today",                 "Thu Jun 12","#e8f4f8"); }
                                @{ ExRow("Total FNI tested (WTD)","1,240",     "#e8f4f8"); }
                                @{ ExRow("Pass",                  "1,228",     "#22c55e"); }
                                @{ ExRow("Fail",                  "12",        "#ff3b3b"); }
                                @{ ExRow("FNI Yield",             "99.03%",    "#22c55e"); }
                                @{ ExRow("Badge",                 "ON TARGET", "#22c55e"); }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               FNI PLANNED VS ACTUAL
               ------------------------------------------ *@
            @if (SectionVisible("fniplan"))
            {
                <div id="sec-fniplan" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.Speed, "FNI PLANNED VS ACTUAL", "Week-to-date FNI output against your configured weekly target -- purple accent", "#a78bfa"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
                        <div>
                            @{ InfoBox(Icons.Material.Filled.Storage, "WHERE THE DATA COMES FROM",
                                "This card uses the exact same FNI dataset as the FNI Yield card -- the same customer, family, route step, and week-to-date date range. " +
                                "No additional database query is made. The difference is what this card does with that data: instead of calculating a yield percentage, " +
                                "it compares how many units have passed FNI this week against your planned weekly target quantity.",
                                "#a78bfa"); }

                            @{ InfoBox(Icons.Material.Filled.Settings, "WHERE THE PLANNED QTY COMES FROM",
                                "The 'FNI Planned Qty' number is the value you typed into the 'FNI Planned Qty (today)' field on the configure screen before launching the dashboard. " +
                                "Example: if you entered 2000, the gauge expects 2000 FNI passes by end of week. " +
                                "You can change this number by going back to configure (press Reconfigure) and relaunching.",
                                "#a78bfa"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:4px;">BADGE STATUS EXPLAINED</div>
                            @{ ThresholdRow("* ON TARGET", "Actual pass count is 100% or more of the FNI planned quantity for the week.", "#22c55e"); }
                            @{ ThresholdRow("* MONITOR",   "Actual pass count is between 80% and 99% of the FNI planned quantity.", "#f59e0b"); }
                            @{ ThresholdRow("* AT RISK",   "Actual pass count is below 80% of the FNI planned quantity -- production is significantly behind plan.", "#ff3b3b"); }
                        </div>
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">HOW EACH NUMBER IS CALCULATED</div>

                            @{ CalcBox("PLANNED (target)",
                                "The FNI Planned Qty you entered on the configure screen",
                                "This is your weekly production target for the FNI step. It does not change until you reconfigure the dashboard. " +
                                "It appears as the denominator in the gauge and as the right-hand number in the stat strip.",
                                "#a78bfa"); }

                            @{ CalcBox("ACTUAL (pass count)",
                                "Count of FNI records with result = 'PASS' from Monday to today",
                                "The same Pass Count used by the FNI Yield card -- units that cleared FNI on their first run this week. " +
                                "As production continues through the week, this number grows.",
                                "#a78bfa"); }

                            @{ CalcBox("% PLAN",
                                "(Actual Pass Count / Planned Qty) -- 100",
                                "The plan attainment percentage. A value of 100% means actual output exactly matches the target. " +
                                "Above 100% means the line is running ahead of plan. " +
                                "Below 100% means there is a gap that needs to be recovered. " +
                                "Shown to one decimal place (e.g. 87.5%).",
                                "#a78bfa"); }

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:4px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">* WORKED EXAMPLE (Wednesday mid-week)</div>
                                @{ ExRow("FNI Planned Qty (weekly)",  "2,000",    "#e8f4f8"); }
                                @{ ExRow("FNI Pass count so far (WTD)","1,450",   "#22c55e"); }
                                @{ ExRow("% Plan attainment",         "72.5%",    "#ff3b3b"); }
                                @{ ExRow("Badge",                     "AT RISK",  "#ff3b3b"); }
                                @{ ExRow("Remaining to hit target",   "550 units","#f59e0b"); }
                            </div>

                            <div style="background:#a78bfa0a; border:1px solid #a78bfa22; border-radius:10px; padding:12px 14px; margin-top:10px; display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Style="color:#a78bfa; font-size:15px; flex-shrink:0; margin-top:1px;" />
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    Because the data window is week-to-date (Monday -> today), the ACTUAL number on Wednesday is naturally lower than it will be on Friday.
                                    An AT RISK badge early in the week is normal if the line runs steady. Check the badge again closer to end-of-week for a meaningful assessment.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               NCR / CAR COMPLIANCE
               ------------------------------------------ *@
            @if (SectionVisible("ncr"))
            {
                <div id="sec-ncr" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.AssignmentLate, "NCR / CAR COMPLIANCE PANEL", "Non-Conformance & Corrective Action tracking -- purple accent", "#a78bfa"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
                        <div>
                            @{ InfoBox(Icons.Material.Filled.Storage, "WHERE THE DATA COMES FROM",
                                "The compliance panel loads three separate record types from the LCC database: " +
                                "NCR (Non-Conformance Reports), CAR (Corrective Action Reports via the JCAS system), and overview groupings. " +
                                "NCR records are grouped by problem category (e.g. 'Workmanship', 'ESD', 'Component'). " +
                                "CAR records are grouped by their CAR category. Each group card shows the count of open and closed items in that category.",
                                "#a78bfa"); }

                            @{ InfoBox(Icons.Material.Filled.FilterAlt, "HOW THE DATA IS FILTERED",
                                "The compliance panel is scoped to the current production bay (process area). " +
                                "It only shows NCR and CAR records that belong to your active bay. " +
                                "There is no date filter applied -- it shows all open records regardless of how old they are, " +
                                "plus closed records so you can see the full picture for your bay.",
                                "#a78bfa"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:4px;">WHAT 'OPEN' AND 'CLOSED' MEAN</div>
                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-bottom:8px;">
                                <div style="color:#ffaa00; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:6px;">OPEN</div>
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    An NCR or CAR is still open when it has not been formally closed in the system
                                    AND the team has not yet completed the D7 step of the 8D process.
                                    Open records require active follow-up from the responsible owner.
                                </div>
                            </div>
                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-bottom:8px;">
                                <div style="color:#22c55e; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:6px;">CLOSED</div>
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    A record is counted as closed when <em>either</em> the status is set to "Closed" in the system,
                                    <em>or</em> when Discipline 7 (Preventive Action) of the 8D process has been completed --
                                    whichever happens first. You do not need both conditions; one is enough.
                                </div>
                            </div>

                            @{ InfoBox(Icons.Material.Filled.Help, "WHAT IS D7 (DISCIPLINE 7)?",
                                "The 8D (Eight Disciplines) is a structured problem-solving method. Discipline 7 is the 'Preventive Action' step -- " +
                                "where the team puts permanent fixes in place to stop the same problem from happening again anywhere in the organisation. " +
                                "Completing D7 means the root cause has been fully addressed, so the system treats the record as resolved even if the formal status field has not yet been updated.",
                                "#a78bfa"); }
                        </div>
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">HOW EACH NUMBER IS CALCULATED</div>

                            @{ CalcBox("Total (per category group)",
                                "Count of all NCR or CAR records in that category for your bay",
                                "Every record in that category -- whether open or closed -- is counted. This is the denominator for the compliance percentage.",
                                "#a78bfa"); }

                            @{ CalcBox("Open Count",
                                "Count of records that are neither closed nor D7-complete",
                                "Records that still require action. A high open count in a category signals a recurring quality problem area that needs attention.",
                                "#a78bfa"); }

                            @{ CalcBox("Closed Count",
                                "Count where status = 'Closed'  OR  D7 step is complete",
                                "Records that have been fully resolved by either formal closure or completion of the preventive action step.",
                                "#a78bfa"); }

                            @{ CalcBox("Age (days open)",
                                "Today's date  ->  the date the record was created",
                                "How long the record has been waiting for resolution. Records open more than 30 days appear in amber. More than 60 days appear in red.",
                                "#a78bfa"); }

                            @{ CalcBox("Compliance %",
                                "(Closed / Total) -- 100",
                                "The closure rate for that category. A higher percentage means more records have been resolved. 100% means everything in that category is closed.",
                                "#a78bfa"); }

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:4px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">* WORKED EXAMPLE -- NCR Category 'Workmanship'</div>
                                @{ ExRow("Total NCRs in category",  "18",    "#e8f4f8"); }
                                @{ ExRow("Closed",                  "13",    "#22c55e"); }
                                @{ ExRow("Open",                    "5",     "#ffaa00"); }
                                @{ ExRow("Compliance",              "72.2%", "#f59e0b"); }
                                @{ ExRow("Oldest open record",      "47 days","#ff3b3b"); }
                            </div>

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:10px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:6px;">DRILL-DOWN DIALOGS</div>
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    Click any category card to open a detailed table of all records in that category.
                                    The dialog shows a KPI strip at the top (Total / Open / Closed / Overdue) and a
                                    full searchable table with columns: NCR/CAR No, Type, Category, Status, Bay, Department,
                                    CAR Owner, Issued By, Issue Date, Closure Status, and Problem Statement.
                                    Type in the search box to filter across all columns at once.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               GAUGES & VISUALS
               ------------------------------------------ *@
            @if (SectionVisible("gauges"))
            {
                <div id="sec-gauges" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.DonutSmall, "GAUGES & VISUAL INDICATORS", "Understanding the on-screen charts, colors, and trend arrows", "#00e5c0"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:18px;">
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">HALF-CIRCLE GAUGE</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.8; margin-bottom:12px;">
                                The FNI cards each show a half-circle gauge. Here is how to read it:
                            </div>
                            <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:14px;">
                                <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:10px 14px;">
                                    <div style="color:#00d4ff; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:4px;">FNI YIELD GAUGE</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">
                                        The arc fills from left to right as yield increases. 0% = empty arc, 100% = full arc.
                                        The number in the centre is the exact FNI yield percentage to two decimal places (e.g. 99.03%).
                                        Arc color matches the status: green = 98%, amber 90--97.99%, red below 90%.
                                    </div>
                                </div>
                                <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:10px 14px;">
                                    <div style="color:#a78bfa; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:4px;">FNI PLAN VS ACTUAL GAUGE</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">
                                        The arc fills based on how many units have passed vs the planned target.
                                        The number in the centre is the raw pass count (not a percentage).
                                        The label below reads "X ACTUAL / Y TARGET".
                                        Arc turns green when actual = planned.
                                    </div>
                                </div>
                            </div>

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">SAFETY STREAK PROGRESS BAR</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.8;">
                                The horizontal progress bar in the Safety card works differently from a gauge.
                                It represents a journey from 0 to 365 days without incident.
                                The large number above it (e.g. "91") is the current day count.
                                The bar fills proportionally -- 91 days fills roughly one-quarter of the full bar.
                                Milestone dots at 30, 90, 180, and 365 days light up solid when you reach them.
                            </div>
                        </div>
                        <div>
                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px;">STATUS BADGE COLORS -- CONSISTENT ACROSS ALL CARDS</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.8; margin-bottom:10px;">
                                Every card uses the same three-tier color system for its badge in the top-right corner:
                            </div>
                            @{ ThresholdRow("* ON TARGET / ALL CLEAR", "The metric meets or exceeds its target. No action needed.", "#22c55e"); }
                            @{ ThresholdRow("* MONITOR",               "The metric is below target but not yet critical. Keep watching.", "#f59e0b"); }
                            @{ ThresholdRow("* AT RISK / ALERT",       "The metric is significantly below target or a recent event has occurred. Take action.", "#ff3b3b"); }

                            <div style="color:#e8f4f8; font-size:11px; font-weight:700; margin-bottom:8px; margin-top:14px;">SAFETY TREND ARROWS</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.8; margin-bottom:8px;">
                                On the Safety card, a small arrow icon sits next to the 'Last 30 Days' count:
                            </div>
                            <div style="display:flex; flex-direction:column; gap:8px;">
                                <div style="display:flex; align-items:center; gap:10px; background:#060d1f; border:1px solid #1a3a5c; border-radius:8px; padding:8px 12px;">
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Style="color:#22c55e; font-size:20px; flex-shrink:0;" />
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">
                                        <span style="color:#22c55e; font-weight:700;">Green down arrow</span> -- fewer incidents this month than last month. Safety is improving.
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px; background:#060d1f; border:1px solid #1a3a5c; border-radius:8px; padding:8px 12px;">
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Style="color:#7ab3cc; font-size:20px; flex-shrink:0;" />
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">
                                        <span style="color:#e8f4f8; font-weight:700;">Grey flat arrow</span> -- same number of incidents as last month. Situation is stable.
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px; background:#060d1f; border:1px solid #1a3a5c; border-radius:8px; padding:8px 12px;">
                                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="color:#ff3b3b; font-size:20px; flex-shrink:0;" />
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">
                                        <span style="color:#ff3b3b; font-weight:700;">Red up arrow</span> -- more incidents this month than last month. Situation is worsening.
                                    </div>
                                </div>
                            </div>

                            <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-top:12px;">
                                <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:6px;">AUTO-REFRESH INDICATOR</div>
                                <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                    A countdown timer in the toolbar shows how many seconds remain until the next automatic refresh.
                                    When it reaches zero, all panels silently reload in the background without disrupting your view.
                                    You can trigger an immediate refresh at any time without waiting for the countdown.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               DRILL-DOWN DIALOGS
               ------------------------------------------ *@
            @if (SectionVisible("drilldown"))
            {
                <div id="sec-drilldown" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.OpenInFull, "DRILL-DOWN DETAIL DIALOGS", "How to explore individual records behind each card", "#00e5c0"); }

                    <div style="color:#7ab3cc; font-size:12px; line-height:1.8; margin-bottom:14px;">
                        Every card has a button at the bottom that opens a full-screen detail dialog. These dialogs let you look at the individual records behind the summary numbers.
                        All dialogs share the same layout: a <span style="color:#e8f4f8;">header</span> showing the card title and record count,
                        a <span style="color:#e8f4f8;">KPI strip</span> with total / open / closed / overdue counts,
                        a <span style="color:#e8f4f8;">search box</span> to filter across all columns at once, and a
                        <span style="color:#e8f4f8;">data table</span> with sortable columns.
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:14px;">
                        <div style="background:#060d1f; border:1px solid #f59e0b33; border-radius:10px; padding:12px 14px;">
                            <div style="color:#f59e0b; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">SAFETY INCIDENTS</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                Button: <span style="color:#e8f4f8;">SAFETY DETAILS</span><br />
                                Shows all incidents for the fiscal year. Columns include: Safety No., Incident Date, Site, Segment, Sector, Region, Type, Title, Status, Severity, Injury/Illness Type, Classification, Direct Cause, Recordable (yes/no), High Potential (yes/no), Lost Time Days, Restriction Days, CAPA/IP No., and Created date.
                                You can export to <span style="color:#00ff88;">Excel</span> or <span style="color:#00d4ff;">CSV</span>.
                            </div>
                        </div>
                        <div style="background:#060d1f; border:1px solid #00d4ff33; border-radius:10px; padding:12px 14px;">
                            <div style="color:#00d4ff; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">FNI YIELD / PLAN VS ACTUAL</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                Button: <span style="color:#e8f4f8;">VIEW DETAILS</span><br />
                                Both FNI cards share the same drill-down. Shows each individual unit that went through FNI this week with its result (PASS/FAIL), test timestamp, serial number, and other MES test record details.
                                Useful for investigating which specific units failed FNI.
                            </div>
                        </div>
                        <div style="background:#060d1f; border:1px solid #a78bfa33; border-radius:10px; padding:12px 14px;">
                            <div style="color:#a78bfa; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">NCR / CAR RECORDS</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                Button: <span style="color:#e8f4f8;">Click any category card</span><br />
                                Opens a dialog for that specific NCR or CAR category. Columns include: Record No., Type, Category, Status badge, Bay, Department, CAR Owner, Issued By, Issue Date, Closure Status, and Problem Statement.
                                Search box filters all columns at once as you type.
                            </div>
                        </div>
                    </div>

                    @{ InfoBox(Icons.Material.Filled.Lightbulb, "SEARCH TIP FOR DRILL-DOWN DIALOGS",
                        "The search box in each dialog searches across all visible columns simultaneously. " +
                        "You do not need to know which column a value is in -- just type it and the table filters instantly. " +
                        "For example, typing 'ESD' in the NCR dialog will show only rows where ESD appears in any column (category, problem, status, etc.). " +
                        "Click the X button in the search box to clear the filter and see all records again.",
                        "#00e5c0"); }
                </div>
            }

            @* ---* Footer ---* *@
            <div style="text-align:center; padding:16px 0 4px; color:#3d6b8a;
                        font-size:10px; letter-spacing:2px; border-top:1px solid #1a3a5c22;">
                LINE CONTROL CENTER -- BACKEND v3.0
            </div>

        </div>@* end content pane *@

    </div>@* end body *@

</div>@* end root *@

<style>
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: #060d1f; }

@using MudBlazor

<div style="background:linear-gradient(160deg,#060d1f 0%,#0a1628 100%);
            height:90vh; max-height:90vh; padding:0; display:flex; flex-direction:column; overflow:hidden;">

    @* ---* Header ---* *@
    <div style="background:linear-gradient(90deg,#0d1f3c,#0a1628);
                border-bottom:1px solid #1a3a5c;
                padding:16px 24px;
                display:flex; align-items:center; justify-content:space-between;
                flex-shrink:0;">
        <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:40px; height:40px; border-radius:12px;
                        background:linear-gradient(135deg,#00b4d818,#00b4d808);
                        border:1px solid #00b4d833;
                        display:flex; align-items:center; justify-content:center;
                        box-shadow:0 0 20px #00b4d818;">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                         Style="color:#00b4d8; font-size:20px;" />
            </div>
            <div>
                <div style="font-family:'Orbitron',sans-serif; font-size:13px;
                            font-weight:900; color:#e8f4f8; letter-spacing:3px;">
                    USER GUIDE
                </div>
                <div style="color:#7ab3cc; font-size:9px; letter-spacing:2px; margin-top:2px;">
                    LINE CONTROL CENTER -- DASHBOARD REFERENCE
                </div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:10px;">
            <div style="position:relative; display:flex; align-items:center;">
                <MudIcon Icon="@Icons.Material.Filled.Search"
                         Style="position:absolute; left:10px; color:#7ab3cc; font-size:16px; pointer-events:none;" />
                <input @bind="_searchText" @bind:event="oninput"
                       placeholder="Search guide"
                       style="background:#0a1628; border:1px solid #1a3a5c; border-radius:8px;
                              color:#e8f4f8; font-size:12px; padding:7px 12px 7px 32px;
                              outline:none; width:200px; letter-spacing:0.3px;" />
                @if (!string.IsNullOrWhiteSpace(_searchText))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="MudSize.Small"
                                   Style="position:absolute; right:4px; color:#7ab3cc; padding:2px;"
                                   OnClick="@(() => _searchText = string.Empty)" />
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Style="color:#7ab3cc; background:#1a3a5c44; border-radius:8px;"
                           OnClick="Close" />
        </div>
    </div>

    @* ---* Body: sidebar + content ---* *@
    <div style="flex:1; display:flex; overflow:hidden;">

        @* ---* Sidebar nav ---* *@
        <div style="width:200px; flex-shrink:0; background:#060d1f;
                    border-right:1px solid #1a3a5c;
                    overflow-y:auto; padding:16px 10px;">
            @foreach (var s in _sections)
            {
                var isActive = _activeSection == s.Id;
                var visible  = string.IsNullOrWhiteSpace(_searchText) ||
                               s.Keywords.Any(k => k.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
                if (!visible) continue;
                <div @onclick="() => SetSection(s.Id)"
                     style="display:flex; align-items:center; gap:8px;
                            padding:9px 10px; border-radius:8px; cursor:pointer; margin-bottom:2px;
                            background:@(isActive ? s.Color + "18" : "transparent");
                            border:1px solid @(isActive ? s.Color + "44" : "transparent");
                            transition:all 0.15s;">
                    <MudIcon Icon="@s.Icon"
                             Style="@($"color:{(isActive ? s.Color : "#3d6b8a")}; font-size:16px; flex-shrink:0;")" />
                    <span style="color:@(isActive ? s.Color : "#7ab3cc"); font-size:10px;
                                 font-weight:@(isActive ? "700" : "400"); letter-spacing:1px;
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @s.Title
                    </span>
                </div>
            }
        </div>

        @* ---* Content pane ---* *@
        <div style="flex:1; overflow-y:auto; padding:24px 28px;" id="ug-content">

        @* ---* Local render helpers ---* *@
        @{
            void GuideHeader(string icon, string title, string subtitle, string color)
            {
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                    <div style="width:36px; height:36px; border-radius:10px;
                                background:@(color)18; border:1px solid @(color)33;
                                display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <MudIcon Icon="@icon" Style="@($"color:{color}; font-size:18px;")" />
                    </div>
                    <div>
                        <div style="color:@color; font-family:'Orbitron',sans-serif;
                                    font-size:11px; font-weight:700; letter-spacing:2px;">@title</div>
                        <div style="color:#7ab3cc; font-size:10px; letter-spacing:1px; margin-top:1px;">@subtitle</div>
                    </div>
                    <div style="flex:1; height:1px; background:linear-gradient(90deg,@(color)33,transparent); margin-left:4px;"></div>
                </div>
            }

            void StepBox(string num, string title, string desc, string color)
            {
                <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                        <div style="width:22px; height:22px; border-radius:50%;
                                    background:@(color)22; border:1px solid @(color)44;
                                    display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <span style="color:@color; font-size:10px; font-weight:700;">@num</span>
                        </div>
                        <span style="color:#e8f4f8; font-size:11px; font-weight:600;">@title</span>
                    </div>
                    <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">@desc</div>
                </div>
            }

            void CalcBox(string name, string formula, string desc, string color)
            {
                <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:10px;
                            padding:10px 14px; margin-bottom:8px;">
                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:4px;">@name</div>
                    <div style="color:@color; font-family:monospace; font-size:11px; font-weight:700;
                                margin-bottom:5px; letter-spacing:0.3px;">@formula</div>
                    <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">@desc</div>
                </div>
            }

            void ThresholdRow(string badge, string desc, string color)
            {
                <div style="display:flex; align-items:baseline; gap:8px; margin-bottom:6px;">
                    <span style="display:inline-block; border:1px solid @(color)44; background:@(color)0c;
                                 border-radius:20px; padding:2px 10px;
                                 color:@color; font-size:9px; font-weight:700; letter-spacing:1px;
                                 white-space:nowrap; flex-shrink:0;">@badge</span>
                    <span style="color:#7ab3cc; font-size:11px; line-height:1.5;">@desc</span>
                </div>
            }

            void ExRow(string label, string value, string color)
            {
                <div style="display:flex; align-items:center; justify-content:space-between;
                            padding:5px 0; border-bottom:1px solid #1a3a5c22;">
                    <span style="color:#7ab3cc; font-size:11px;">@label</span>
                    <span style="color:@color; font-size:11px; font-weight:700; font-family:monospace;">@value</span>
                </div>
            }

            void InfoBox(string icon, string title, string body, string color)
            {
                <div style="background:@(color)0a; border:1px solid @(color)22; border-radius:10px; padding:12px 14px; margin-bottom:10px;">
                    <div style="display:flex; align-items:flex-start; gap:8px;">
                        <MudIcon Icon="@icon" Style="@($"color:{color}; font-size:15px; flex-shrink:0; margin-top:1px;")" />
                        <div>
                            <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:4px;">@title</div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">@body</div>
                        </div>
                    </div>
                </div>
            }
        }

            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var matchCount = _sections.Count(s =>
                    s.Keywords.Any(k => k.Contains(_searchText, StringComparison.OrdinalIgnoreCase)));
                <div style="background:#00b4d80a; border:1px solid #00b4d822; border-radius:10px;
                            padding:8px 16px; margin-bottom:16px; font-size:11px; color:#7ab3cc;">
                    Showing <span style="color:#00b4d8; font-weight:700;">@matchCount</span>
                    section@(matchCount == 1 ? "" : "s") matching
                    "<span style="color:#e8f4f8;">@_searchText</span>"
                </div>
            }

            @* ------------------------------------------
               OVERVIEW
               ------------------------------------------ *@
            @if (SectionVisible("intro"))
            {
                <div id="sec-intro" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.Info, "OVERVIEW", "What this dashboard does and where its data comes from", "#00b4d8"); }

                    <div style="background:linear-gradient(135deg,#00b4d80a,#0055ff06);
                                border:1px solid #00b4d822; border-radius:14px;
                                padding:16px 20px; margin-bottom:16px;">
                        <div style="display:flex; align-items:flex-start; gap:12px;">
                            <MudIcon Icon="@Icons.Material.Filled.Info"
                                     Style="color:#00b4d8; font-size:20px; flex-shrink:0; margin-top:2px;" />
                            <div>
                                <div style="color:#e8f4f8; font-size:13px; font-weight:600; margin-bottom:6px;">
                                    About This Dashboard
                                </div>
                                <div style="color:#7ab3cc; font-size:12px; line-height:1.9;">
                                    The <span style="color:#00b4d8; font-weight:700;">Line Control Center -- Backend</span>
                                    is a real-time production monitoring dashboard. It pulls live data from two separate databases --
                                    the <span style="color:#e8f4f8; font-weight:600;">MES (Manufacturing Execution System)</span> for
                                    test results and FNI inspection records, and the
                                    <span style="color:#e8f4f8; font-weight:600;">LCC (Line Control Center)</span> database for
                                    safety incidents and quality compliance records.
                                    <br /><br />
                                    The dashboard shows six panels: <span style="color:#f59e0b;">Safety</span>,
                                    <span style="color:#00d4ff;">FNI Yield</span>,
                                    <span style="color:#a78bfa;">FNI Planned vs Actual</span>,
                                    a live <span style="color:#00b4d8;">Bay Camera feed</span>, and the
                                    <span style="color:#a78bfa;">NCR / CAR Compliance panel</span> at the bottom.
                                    <br /><br />
                                    The screen refreshes automatically every <span style="color:#00b4d8; font-weight:700;">120 seconds</span>.
                                    You can also press the refresh button in the toolbar to update immediately at any time.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
                        <div style="background:#060d1f; border:1px solid #f59e0b33; border-radius:10px; padding:12px 14px;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                                <MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" Style="color:#f59e0b; font-size:16px;" />
                                <span style="color:#f59e0b; font-size:10px; font-weight:700; letter-spacing:1px;">SAFETY</span>
                            </div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">Tracks workplace incidents for the current fiscal year (Sep--Aug). Shows days without incident and trend.</div>
                        </div>
                        <div style="background:#060d1f; border:1px solid #00d4ff33; border-radius:10px; padding:12px 14px;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Style="color:#00d4ff; font-size:16px;" />
                                <span style="color:#00d4ff; font-size:10px; font-weight:700; letter-spacing:1px;">FNI YIELD</span>
                            </div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">Shows the week-to-date pass rate at the Final Numeric Inspection step for your selected product family.</div>
                        </div>
                        <div style="background:#060d1f; border:1px solid #a78bfa33; border-radius:10px; padding:12px 14px;">
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                                <MudIcon Icon="@Icons.Material.Filled.Speed" Style="color:#a78bfa; font-size:16px;" />
                                <span style="color:#a78bfa; font-size:10px; font-weight:700; letter-spacing:1px;">FNI PLAN VS ACTUAL</span>
                            </div>
                            <div style="color:#7ab3cc; font-size:11px; line-height:1.6;">Compares how many units actually passed FNI this week against your configured weekly target quantity.</div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               HOW TO USE
               ------------------------------------------ *@
            @if (SectionVisible("howto"))
            {
                <div id="sec-howto" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.Tune, "HOW TO USE THE DASHBOARD", "Step-by-step walk-through from configure to live view", "#00b4d8"); }

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:16px;">
                        @{ StepBox("1", "Select a Product Family",
                            "On the configure screen, scroll or search the list on the left. Click any row to highlight it. " +
                            "Each row shows the Family name and the Customer / Division it belongs to. " +
                            "Example: pick 'G85' under 'Motorola / EMS' to track that product line.",
                            "#00b4d8"); }
                        @{ StepBox("2", "Set Your Shift Date",
                            "Use the date-picker to choose the date you want to review. " +
                            "This date is used directly for all data queries. " +
                            "Important: if you are reviewing Night Shift, the dashboard automatically looks back one day because night shift crosses midnight.",
                            "#00b4d8"); }
                        @{ StepBox("3", "Enter the Planned Quantity",
                            "Enter the weekly FNI target in the 'Planned Qty' field. This is the number of units you expect to pass the FNI inspection step by end of the current week. " +
                            "The default is 10,000. Change it to match your actual weekly production target before launching. " +
                            "Example: enter 8000 if your weekly FNI plan is 8,000 units.",
                            "#00b4d8"); }
                        @{ StepBox("4", "Launch the Dashboard",
                            "Click LAUNCH DASHBOARD. The system fetches all panels simultaneously. " +
                            "A loading spinner appears while data is being retrieved. " +
                            "Once loaded, the live view appears and auto-refresh begins counting down from 120 seconds.",
                            "#00b4d8"); }
                    </div>

                    <div style="background:#060d1f; border:1px solid #1a3a5c; border-radius:12px; padding:14px 18px;">
                        <div style="color:#e8f4f8; font-size:11px; font-weight:700; letter-spacing:1px; margin-bottom:10px;">TOP BAR CONTROLS (TOP-RIGHT OF SCREEN)</div>
                        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Style="color:#f59e0b; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">SET DPM TARGET</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Opens a popover to change the DPM (Defects Per Million) target threshold. Applies immediately in real time. See the Top Bar Controls section for full details.</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Style="color:#00b4d8; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">RECONFIGURE</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Returns you to the configure screen so you can change the product family, shift date, or planned quantity and relaunch.</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Refresh" Style="color:#00b4d8; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">REFRESH NOW</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Forces an immediate reload of all dashboard panels without waiting for the 120-second countdown to finish.</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Style="color:#00e5c0; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">SCREEN ZOOM</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Opens a zoom panel with separate size sliders for the BACKEND – SOMS camera and the Risk & Learning panel. See the Top Bar Controls section for full details.</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.CastForEducation" Style="color:#22c55e; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">BRIEFING</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Opens the daily shift briefing. Badge turns green once viewed to confirm you have checked it for this session.</div>
                                </div>
                            </div>
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="color:#00b4d8; font-size:16px; flex-shrink:0; margin-top:1px;" />
                                <div>
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:3px;">USER GUIDE</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.5;">Opens this guide at any time while viewing the dashboard.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ------------------------------------------
               TOP BAR CONTROLS
               ------------------------------------------ *@
            @if (SectionVisible("topbar"))
            {
                <div id="sec-topbar" style="margin-bottom:28px;">
                    @{ GuideHeader(Icons.Material.Filled.Dashboard, "TOP BAR CONTROLS", "Every button in the top-right toolbar — what it does and how to use it", "#00e5c0"); }

                    @* DPM Target *@
                    <div style="background:#060d1f; border:1px solid #f59e0b33; border-radius:12px; padding:14px 18px; margin-bottom:12px;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                            <div style="width:30px; height:30px; border-radius:8px; background:#f59e0b18; border:1px solid #f59e0b33; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Style="color:#f59e0b; font-size:16px;" />
                            </div>
                            <div style="color:#f59e0b; font-size:10px; font-weight:700; letter-spacing:2px;">SET DPM TARGET</div>
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
                            <div>
                                @{ InfoBox(Icons.Material.Filled.Info, "WHAT IS DPM?",
                                    "DPM stands for Defects Per Million. It is a quality metric that shows how many units out of every one million produced were found to be defective. " +
                                    "A lower DPM is better. The DPM Target is the threshold value used to colour-code the DPM indicators on the dashboard — " +
                                    "results above the target appear red, results below appear green.",
                                    "#f59e0b"); }
                                @{ InfoBox(Icons.Material.Filled.TouchApp, "HOW TO CHANGE THE TARGET",
                                    "Click the target icon (circle with crosshair) in the top-right toolbar. A small popover opens showing a number field. " +
                                    "Type a new target value (minimum 1, maximum 10,000) and click APPLY. " +
                                    "The dashboard updates immediately — no page reload required. " +
                                    "Click CANCEL or click anywhere outside the popover to close it without saving.",
                                    "#f59e0b"); }
                            </div>
                            <div>
                                <div style="background:#0a1628; border:1px solid #1a3a5c; border-radius:10px; padding:12px 14px; margin-bottom:10px;">
                                    <div style="color:#e8f4f8; font-size:10px; font-weight:700; letter-spacing:1px; margin-bottom:8px;">CURRENT TARGET DISPLAY</div>
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                        Inside the popover, the current target is always shown at the bottom in amber text (e.g. <span style="color:#f59e0b; font-weight:700;">CURRENT: 800 DPM</span>).
                                        This acts as a reminder of what the active setting is before you make any changes.
                                        The default target when the dashboard first loads is <span style="color:#f59e0b; font-weight:700;">800 DPM</span>.
                                    </div>
                                </div>
                                <div style="background:#f59e0b0a; border:1px solid #f59e0b22; border-radius:10px; padding:12px 14px; display:flex; align-items:flex-start; gap:8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Style="color:#f59e0b; font-size:15px; flex-shrink:0; margin-top:1px;" />
                                    <div style="color:#7ab3cc; font-size:11px; line-height:1.7;">
                                        The DPM Target is a session setting. It resets to the default (800) each time you relaunch or reconfigure the dashboard.
                                        If your line has a different standard DPM target, change it right after launching each shift.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Reconfigure *@
                    <div style="background:#060d1f; border:1px solid #00b4d833; border-radius:12px; padding:14px 18px; margin-bottom:12px;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                            <div style="width:30px; height:30px; border-radius:8px; background:#00b4d818; border:1px solid #00b4d833; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Style="color:#00b4d8; font-size:16px;" />
                            </div>
                            <div style="color:#00b4d8; font-size:10px; font-weight:700; letter-spacing:2px;">RECONFIGURE</div>
                        </div>
                        <div style="color:#7ab3cc; font-size:11px; line-height:1.8;">
                            The Reconfigure button (slider icon) returns you to the configuration screen without closing the browser tab.
                            Use this when you need to change the <span style="color:#e8f4f8;">product family</span>, <span style="color:#e8f4f8;">shift date</span>,
                            or <span style="color:#e8f4f8;">FNI planned quantity</span>.
                            After making changes on the configure screen, click <span style="color:#e8f4f8; font-weight:700;">LAUNCH DASHBOARD</span> to reload all panels with the new settings.
                            Note: reconfiguring resets the briefing badge and the DPM target back to defaults.
                        </div>
                    </div>

                    @* Refresh *@
                    <div style="background:#060d1f; border:1px solid #00b4d833; border-radius:12px; padding:14px 18px; margin-bottom:12px;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">

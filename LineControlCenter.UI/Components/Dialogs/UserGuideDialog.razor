                        <div>
                            @{ InfoBox(Icons.Material.Filled.Info, "WHAT IS THE BRIEFING?",
                                "The Daily Shift Briefing opens a PDF document that has been prepared by the section owner before the shift. " +
                                "The PDF contains the official briefing material for the day -- such as safety topics, quality alerts, production targets, or process updates. " +
                                "During the shift start, the supervisor presents this document to the team and walks through each item. " +
                                "Operators follow along as the supervisor explains the content based on the PDF.",
                                "#22c55e"); }

                            @{ InfoBox(Icons.Material.Filled.OpenInNew, "HOW TO OPEN THE BRIEFING",

@using LineControlCenter.Application.DTOs
@using MudBlazor
@inject LineControlCenter.Application.Interfaces.IEmailReportService EmailReportService
@inject ISnackbar Snackbar

<MudDialog Style="background:#060d1f; border-radius:20px; overflow:hidden;">
    <DialogContent>
        <div style="display:flex; flex-direction:column; height:82vh; max-height:82vh;">

            @* ── Header ── *@
            <div style="display:flex; align-items:center; justify-content:space-between;
                        padding:20px 28px 16px; flex-shrink:0;
                        background:linear-gradient(135deg,#0d1a2e 0%,#060d1f 100%);
                        border-bottom:1px solid #0d2137;">
                <div style="display:flex; align-items:center; gap:14px;">
                    <div style="width:42px; height:42px; border-radius:12px;
                                background:#00d4ff18; border:1px solid #00d4ff44;
                                display:flex; align-items:center; justify-content:center;">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                                 Style="color:#00d4ff; font-size:22px;" />
                    </div>
                    <div>
                        <div style="color:#00d4ff; font-family:'Orbitron',sans-serif;
                                    font-size:14px; font-weight:800; letter-spacing:3px; margin-bottom:3px;">
                            CAR &nbsp;·&nbsp; @CategoryName
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="background:#00d4ff15; border:1px solid #00d4ff30;
                                         color:#00d4ff; font-size:10px; letter-spacing:1px;
                                         padding:2px 10px; border-radius:20px; font-weight:600;">
                                @Items.Count RECORDS
                            </span>
                            <span style="color:#8899aa; font-size:10px;">THIS WEEK</span>
                        </div>
                    </div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <MudTooltip Text="Send Report by Email" Placement="Placement.Bottom">
                        <MudIconButton Icon="@Icons.Material.Filled.Email"
                                       Size="MudSize.Small"
                                       Style="@($"color:#00d4ff; background:{(_showEmailPanel ? "#00d4ff22" : "#1a2a3e")}; border:1px solid {(_showEmailPanel ? "#00d4ff66" : "#2a3a50")}; border-radius:10px; width:36px; height:36px;")"
                                       OnClick="() => _showEmailPanel = !_showEmailPanel" />
                    </MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="MudSize.Small"
                                   Style="color:#e0eaf8; background:#1a2a3e; border:1px solid #2a3a50;
                                          border-radius:10px; width:36px; height:36px;"
                                   OnClick="Cancel" />
                </div>
            </div>

            @* ── Email compose panel ── *@
            @if (_showEmailPanel)
            {
                <div style="padding:14px 28px; background:#070f1e; border-bottom:1px solid #00d4ff22; flex-shrink:0;">
                    <div style="display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap;">
                        <div style="flex:1; min-width:200px;">
                            <div style="color:#7ab3cc; font-size:9px; letter-spacing:2px; margin-bottom:4px;">TO (comma or semicolon separated)</div>
                            <MudTextField @bind-Value="_emailTo" Placeholder="user@example.com"
                                          Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                                          Style="background:#0a1628;" Disabled="@_sendingEmail" />
                        </div>
                        <div style="flex:2; min-width:200px;">
                            <div style="color:#7ab3cc; font-size:9px; letter-spacing:2px; margin-bottom:4px;">NOTE (optional)</div>
                            <MudTextField @bind-Value="_emailNote" Placeholder="Add a note..."
                                          Variant="MudBlazor.Variant.Outlined" Margin="Margin.Dense"
                                          Style="background:#0a1628;" Disabled="@_sendingEmail" />
                        </div>
                        <MudButton Variant="MudBlazor.Variant.Filled"
                                   Style="background:#00b4d8; color:#fff; border-radius:10px; height:40px; min-width:140px; font-family:'Orbitron',sans-serif; font-size:10px; letter-spacing:1px;"
                                   OnClick="SendEmailReportAsync"
                                   Disabled="@(_sendingEmail || string.IsNullOrWhiteSpace(_emailTo))">
                            <div style="display:flex; align-items:center; gap:8px;">
                                @if (_sendingEmail)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:16px; height:16px; color:#fff;" />
                                    <span>SENDING...</span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Send" Style="font-size:16px;" />
                                    <span>SEND REPORT</span>
                                }
                            </div>
                        </MudButton>
                    </div>
                </div>
            }

            @* ── KPI Strip ── *@
            <div style="display:flex; gap:8px; padding:14px 28px 0; flex-shrink:0;">
                @{
                    var openCount     = Items.Count(x => !IsCompleted(x));
                    var closedCount   = Items.Count(x => IsCompleted(x));
                    var overdueCount  = Items.Count(x => !IsCompleted(x) &&
                                            x.D7DueDate.HasValue && x.D7DueDate.Value < DateOnly.FromDateTime(DateTime.Today));
                    var kpis = new (string Icon, string Label, string Value, string Color)[]
                    {
                        (Icons.Material.Filled.Assignment,     "TOTAL",   Items.Count.ToString(),  "#00d4ff"),
                        (Icons.Material.Filled.LockOpen,       "OPEN",    openCount.ToString(),    openCount   > 0 ? "#ffaa00" : "#00ff88"),
                        (Icons.Material.Filled.CheckCircle,    "CLOSED",  closedCount.ToString(),  "#00ff88"),
                        (Icons.Material.Filled.HourglassEmpty, "OVERDUE", overdueCount.ToString(), overdueCount > 0 ? "#ff4444" : "#334455"),
                    };
                }
                @foreach (var k in kpis)
                {
                    <div style="flex:1; background:#0b1422; border:1px solid #1a3a5c;
                                border-radius:10px; padding:10px 14px; position:relative; overflow:hidden;">
                        <div style="position:absolute; top:0; left:0; right:0; height:1.5px;
                                    background:linear-gradient(90deg,transparent,@(k.Color),transparent); opacity:0.6;"></div>
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                            <MudIcon Icon="@k.Icon" Style="@($"color:{k.Color}; font-size:12px;")" />
                            <span style="color:#667788; font-size:8px; letter-spacing:2px; font-weight:700;">@k.Label</span>
                        </div>
                        <div style="color:@(k.Color); font-size:18px; font-weight:900;
                                    font-family:'Orbitron',monospace;">@k.Value</div>
                    </div>
                }
            </div>

            @* ── Search Box ── *@
            <div style="padding:12px 28px 0; flex-shrink:0;">
                <MudTextField @bind-Value="_search"
                              Placeholder="Search all columns…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Info"
                              Variant="MudVariant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              FullWidth="true"
                              Style="background:#0b1422; border-radius:10px; color:#e0eaf8; font-size:13px;" />
            </div>

            @* ── Table ── *@
            <div style="flex:1; overflow-y:auto; padding:14px 28px 28px;">
                <MudDataGrid T="JcasMainTblDto"
                             Items="@FilteredItems"
                             Filterable="false"
                             SortMode="SortMode.Multiple"
                             Dense="true"
                             Hover="true"
                             RowsPerPage="20"
                             Style="background:#0d1a2e; border:1px solid #0d2137; border-radius:12px; overflow:hidden;">
                    <Columns>
                        @* URL *@
                        <TemplateColumn Title="URL" Sortable="false" Filterable="false"
                                        HeaderStyle="white-space:nowrap;">
                            <CellTemplate>
                                @if (!string.IsNullOrWhiteSpace(context.Item.JcasUrl))
                                {
                                    <a href="@context.Item.JcasUrl" target="_blank"
                                       style="color:#00d4ff; font-size:11px; text-decoration:none;">
                                        <MudIcon Icon="@Icons.Material.Filled.OpenInNew"
                                                 Style="font-size:15px; vertical-align:middle;" />
                                    </a>
                                }
                                else
                                {
                                    <span style="color:#334455;">—</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        @* JCAS No *@
                        <PropertyColumn Property="x => x.JcasRecordNumber" Title="JCAS No"
                                        HeaderStyle="white-space:nowrap;"
                                        CellStyle="color:#e0eaf8; font-family:monospace; font-size:12px;" />

                        @* Customer *@
                        <TemplateColumn Title="Customer" SortBy="x => x.CustomerName ?? string.Empty"
                                        HeaderStyle="white-space:nowrap;">
                            <CellTemplate>
                                <span style="color:#00d4ff; font-size:12px;">
                                    @(context.Item.CustomerName ?? "—")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Created Date *@
                        <TemplateColumn Title="Created Date" SortBy="x => x.JcasCreatedDate"
                                        HeaderStyle="white-space:nowrap;">
                            <CellTemplate>
                                <span style="color:#8899aa; font-size:11px; font-family:monospace;">
                                    @(context.Item.JcasCreatedDate?.ToString("MM/dd/yyyy") ?? "—")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Failure Mode *@
                        <PropertyColumn Property="x => x.FailureMode" Title="Failure Mode"
                                        HeaderStyle="white-space:nowrap;"
                                        CellStyle="color:#ffaa00; font-size:12px;" />

                        @* Problem Description *@
                        <TemplateColumn Title="Problem Description" Sortable="false"
                                        HeaderStyle="white-space:nowrap;" Style="min-width:320px;">
                            <CellTemplate>
                                <span style="color:#c0d0e0; font-size:11px;"
                                      title="@context.Item.ProblemDescription">
                                    @(context.Item.ProblemDescription?.Length > 120
                                        ? context.Item.ProblemDescription[..120] + "…"
                                        : context.Item.ProblemDescription ?? "—")
                                </span>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string                        CategoryName { get; set; } = "";
    [Parameter] public IReadOnlyList<JcasMainTblDto> Items        { get; set; } = [];

    private string _search = "";

    private IEnumerable<JcasMainTblDto> FilteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? Items
            : Items.Where(x =>
                Contains(x.JcasRecordNumber) ||
                Contains(x.CustomerName)     ||
                Contains(x.JcasCreatedDate?.ToString("MM/dd/yyyy")) ||
                Contains(x.FailureMode)      ||
                Contains(x.ProblemDescription));

    private bool Contains(string? value) =>
        value?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true;

    private static bool IsCompleted(JcasMainTblDto x) =>
        x.Phase?.Equals("Complete",  StringComparison.OrdinalIgnoreCase) == true ||
        x.Phase?.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) == true;

    // ── Email report ──────────────────────────────────────────────────────
    private bool   _showEmailPanel = false;
    private string _emailTo        = string.Empty;
    private string _emailNote      = string.Empty;
    private bool   _sendingEmail   = false;

    private async Task SendEmailReportAsync()
    {
        _sendingEmail = true;
        StateHasChanged();
        try
        {
            await EmailReportService.SendCarReportAsync(_emailTo, CategoryName, Items, _emailNote);
            Snackbar.Add("CAR report sent successfully!", Severity.Success, cfg =>
            {
                cfg.Icon = Icons.Material.Filled.MarkEmailRead;
                cfg.VisibleStateDuration = 4000;
            });
            _showEmailPanel = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to send: {ex.Message}", Severity.Error, cfg =>
            {
                cfg.Icon = Icons.Material.Filled.ErrorOutline;
                cfg.VisibleStateDuration = 6000;
            });
        }
        finally { _sendingEmail = false; StateHasChanged(); }
    }

    private void Cancel() => MudDialog.Cancel();
}
